/**
 * 志木なるほど お店めぐりDX：公開承認済み店舗だけを配信
 * このコードは新規作成した単独の Apps Script プロジェクトに貼り付けます。
 * 個人情報を含む登録申請シートは公開しません。
 */
function publicShopsGet_(e) {
  const callback = (e && e.parameter && e.parameter.callback) || '';
  const sheet = SpreadsheetApp.openById('1u9JGrQkqml6qoNqIk-nuLxdcFXAPQ_COkCX3vA7cSX8').getSheetByName('店舗一覧');
  if (!sheet) return respond_({ok:false,error:'店舗一覧シートがありません'}, callback);
  const values = sheet.getDataRange().getDisplayValues();
  if (!values.length) return respond_({ok:true,shops:[]}, callback);
  const headers = values.shift();
  const col = name => headers.indexOf(name);
  const get = (row, name) => col(name) < 0 ? '' : String(row[col(name)] || '').trim();
  const shops = values.filter(row => {
    const state = get(row, '公開状態');
    const permission = get(row, '掲載許可');
    return state === '公開' && ['確認済み','承認済み','はい','YES'].includes(permission) && get(row, '店名');
  }).map(row => ({
    id: get(row, '店舗ID'),
    name: get(row, '店名'),
    category: get(row, '業種'),
    address: get(row, '住所'),
    description: get(row, '紹介文'),
    recommendation: get(row, 'おすすめ商品・サービス'),
    hours: get(row, '営業時間'),
    closed: get(row, '定休日'),
    phone: get(row, '電話番号'),
    site: get(row, '公式サイトURL'),
    map: get(row, 'GoogleマップURL'),
    instagram: get(row, 'Instagram URL'),
    facebook: get(row, 'Facebook URL'),
    photo: get(row, '写真URL'),
    video: get(row, '動画URL'),
    message: get(row, '店主のひと言'),
    updated: get(row, '更新日')
  }));
  return respond_({ok:true,shops:shops}, callback);
}

function respond_(data, callback) {
  const json = JSON.stringify(data).replace(/</g, '\\u003c');
  // GitHub Pages から読み込むため JSONP を使用。
  // コールバック名は英数字・_・. のみ許可し、コード注入を防止。
  if (callback && /^[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*$/.test(callback) && callback.length < 100) {
    return ContentService.createTextOutput(callback + '(' + json + ');')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService.createTextOutput(json)
    .setMimeType(ContentService.MimeType.JSON);
}
function doGet(e){const p=(e&&e.parameter)||{};if(p.mode==='edit')return HtmlService.createHtmlOutput(POST_EDITOR_HTML).setTitle('お店の情報を更新').addMetaTag('viewport','width=device-width,initial-scale=1');if(p.action==='posts')return respond_(postFeed_(p),p.callback||'');if(p.action==='merchantPublic'){if(!/^SHOP-[0-9]{4}$/.test(p.shop||''))return respond_({ok:false},p.callback||'');return respond_(omPublic_(p.shop),p.callback||'');}return publicShopsGet_(e);}
const OM_BOOK='1u9JGrQkqml6qoNqIk-nuLxdcFXAPQ_COkCX3vA7cSX8';
function omBook_(){return SpreadsheetApp.openById(OM_BOOK);}
function omSheet_(name,headers){const b=omBook_();let s=b.getSheetByName(name);if(!s){s=b.insertSheet(name);s.appendRow(headers);s.setFrozenRows(1);}return s;}
function setupMerchantEditing(){
 const b=omBook_(), access=omSheet_('店舗管理',['店舗ID','店名','店主用コード（本人だけに渡す）']);
 const rows=b.getSheetByName('店舗一覧').getDataRange().getDisplayValues(),h=rows.shift();
 const props=PropertiesService.getScriptProperties();
 rows.filter(r=>r[h.indexOf('店舗ID')]&&r[h.indexOf('店名')]).forEach(r=>{const id=r[h.indexOf('店舗ID')];if(!props.getProperty('merchant:'+id)){const code=Utilities.getUuid().replace(/-/g,'');props.setProperty('merchant:'+id,code);access.appendRow([id,r[h.indexOf('店名')],code]);}});
 if(!props.getProperty('merchant:ADMIN')){const code=Utilities.getUuid().replace(/-/g,'');props.setProperty('merchant:ADMIN',code);access.appendRow(['ADMIN','ふじこ編集長用（店主には渡さない）',code]);}
 omSheet_('店主申請',['申請ID','受付日時','店舗ID','種類','状態','内容','公開済みJSON','処理日時']);
 omSheet_('店主画像データ',['画像ID','分割番号','データ']);
 access.getRange('A1:C1').setFontWeight('bold');access.setColumnWidth(0+1,140);access.setColumnWidth(2,280);access.setColumnWidth(3,340);
}
function omAuth_(id,code){const expected=PropertiesService.getScriptProperties().getProperty('merchant:'+String(id));if(!expected||!code||String(code)!==expected)throw new Error('店舗IDまたはコードが違います。');}
function omShop_(id){const rows=omBook_().getSheetByName('店舗一覧').getDataRange().getDisplayValues(),h=rows.shift(),r=rows.find(r=>r[h.indexOf('店舗ID')]===id);if(!r)throw new Error('店舗が見つかりません。');return Object.fromEntries(h.map((k,i)=>[k,r[i]||'']));}
function merchantLogin(id,code){omAuth_(id,code);if(id==='ADMIN')return {admin:true,requests:omRequests_()};return {admin:false,shop:omShop_(id)};}
function omImageData_(ids){const s=omBook_().getSheetByName("店主画像データ");const chunks=s?s.getDataRange().getDisplayValues().slice(1):[];return (ids||[]).map(id=>chunks.filter(r=>r[0]===id).sort((a,b)=>Number(a[1])-Number(b[1])).map(r=>r[2]).join(""));}
function omRequests_(){const s=omSheet_('店主申請',['申請ID','受付日時','店舗ID','種類','状態','内容','公開済みJSON','処理日時']);return s.getDataRange().getDisplayValues().slice(1).filter(r=>r[4]==='確認待ち').map(r=>({id:r[0],date:r[1],shop:r[2],type:r[3],payload:JSON.parse(r[5]),previews:r[3]==="media"?omImageData_(JSON.parse(r[5]).photos):[]}));}
function omText_(v,n){return String(v||'').trim().slice(0,n);}
function omUrl_(v){v=omText_(v,1500);if(v&&!/^https?:\/\//i.test(v))throw new Error('リンクはhttps://またはhttp://から入力してください。');return v;}
function merchantSubmit(id,code,type,p){
 omAuth_(id,code);if(id==='ADMIN')throw new Error('店舗IDで送信してください。');omShop_(id);if(!['info','media','notice'].includes(type))throw new Error('申請の種類が違います。');
 const data={};
 if(type==='info'){['店名','業種','住所','紹介文','おすすめ商品・サービス','営業時間','定休日','電話番号','店主のひと言'].forEach(k=>{if(Object.prototype.hasOwnProperty.call(p,k))data[k]=omText_(p[k],k==='紹介文'?1500:500);});['公式サイトURL','Instagram URL','Facebook URL','LINE公式URL','YouTube URL'].forEach(k=>{if(Object.prototype.hasOwnProperty.call(p,k))data[k]=omUrl_(p[k]);});if(!data['店名'])throw new Error('店名を入力してください。');}
 if(type==='notice'){data.title=omText_(p.title,80);data.body=omText_(p.body,1500);data.end=omText_(p.end,10);if(!data.title||!data.body)throw new Error('タイトルと本文を入力してください。');if(data.end&&!/^\d{4}-\d{2}-\d{2}$/.test(data.end))throw new Error('終了日を確認してください。');}
 const images=[];
 if(type==='media'){data.video=omUrl_(p.video);if(data.video&&!/^https:\/\/(?:www\.)?(?:youtube\.com|youtu\.be|instagram\.com|facebook\.com)\//i.test(data.video))throw new Error('動画はYouTube・Instagram・Facebookのリンクを入力してください。');if(!Array.isArray(p.photos)||p.photos.length>4)throw new Error('写真は4枚までです。');p.photos.forEach(v=>{if(!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(v)||v.length>240000)throw new Error('写真の形式またはサイズを確認してください。');images.push(v);});if(!images.length&&!data.video)throw new Error('写真または動画のリンクを入れてください。');}
 const lock=LockService.getScriptLock();lock.waitLock(15000);try{
 const key='REQ-'+Utilities.getUuid(),blobSheet=omSheet_('店主画像データ',['画像ID','分割番号','データ']);
 if(images.length){data.photos=images.map((v,i)=>{const imageId=key+'-'+i;const chunks=[];for(let j=0;j<v.length;j+=35000)chunks.push([imageId,chunks.length,v.slice(j,j+35000)]);blobSheet.getRange(blobSheet.getLastRow()+1,1,chunks.length,3).setValues(chunks);return imageId;});}
 omSheet_('店主申請',['申請ID','受付日時','店舗ID','種類','状態','内容','公開済みJSON','処理日時']).appendRow([key,Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd HH:mm:ss'),id,type,'確認待ち',JSON.stringify(data),'','']);return {ok:true,id:key,message:'送信しました。ふじこの確認後に公開されます。'};
 }finally{lock.releaseLock();}
}
function merchantDecide(code,requestId,approve,permission){omAuth_('ADMIN',code);const lock=LockService.getScriptLock();lock.waitLock(15000);try{const b=omBook_(),s=b.getSheetByName('店主申請'),rows=s.getDataRange().getDisplayValues(),index=rows.findIndex(r=>r[0]===requestId);if(index<1||rows[index][4]!=='確認待ち')throw new Error('この申請は処理済みです。');const r=rows[index],p=JSON.parse(r[5]);if(approve){if(!permission)throw new Error('掲載許可と内容を確認してください。');if(r[3]==='info'){const master=b.getSheetByName('店舗一覧'),all=master.getDataRange().getDisplayValues(),h=all[0],ri=all.findIndex(row=>row[h.indexOf('店舗ID')]===r[2]);if(ri<1)throw new Error('店舗がありません。');Object.keys(p).forEach(k=>{const ci=h.indexOf(k);if(ci>=0)master.getRange(ri+1,ci+1).setValue(String(p[k]).startsWith("=")?"'"+p[k]:p[k]);});[['公開状態','公開'],['掲載許可','確認済み'],['更新日',Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd')]].forEach(([k,v])=>{const ci=h.indexOf(k);if(ci>=0)master.getRange(ri+1,ci+1).setValue(v);});}s.getRange(index+1,7).setValue(JSON.stringify(p));}s.getRange(index+1,5).setValue(approve?'公開':'見送り');s.getRange(index+1,8).setValue(Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd HH:mm:ss'));return {ok:true,requests:omRequests_()};}finally{lock.releaseLock();}}
function omPublic_(id){const s=omBook_().getSheetByName('店主申請');const result={ok:true,shop:null,notice:null,photos:[],video:''};if(!s)return result;const rows=s.getDataRange().getDisplayValues().slice(1).filter(r=>r[2]===id&&r[4]==='公開');rows.forEach(r=>{const p=JSON.parse(r[6]||'{}');if(r[3]==='info')result.shop=p;if(r[3]==='notice'){result.notice=p;}if(r[3]==='media'){result.video=p.video||'';result.photos=p.photos||[];}});if(result.notice&&result.notice.end&&result.notice.end<Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd'))result.notice=null;
 if(result.photos.length){const chunks=omBook_().getSheetByName('店主画像データ').getDataRange().getDisplayValues().slice(1);result.photos=result.photos.map(id=>chunks.filter(r=>r[0]===id).sort((a,b)=>Number(a[1])-Number(b[1])).map(r=>r[2]).join(''));}return result;}

const MERCHANT_HTML="<!doctype html><html lang=\"ja\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>お店の情報を更新｜志木なるほど お店めぐりDX</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f8f4;color:#193f33;font:16px/1.8 -apple-system,BlinkMacSystemFont,sans-serif}main{max-width:620px;padding:18px;margin:auto}section{background:white;border:1px solid #d4e5db;padding:20px;border-radius:16px;margin:16px 0}h1{font-size:25px}h2{font-size:22px}label{display:block;font-weight:700;margin-top:12px}input,textarea,select,button{font:inherit;width:100%;padding:12px;border:1px solid #a8c8b7;border-radius:10px}textarea{min-height:130px}button{background:#146b57;color:white;font-weight:700;margin-top:14px;cursor:pointer}button:disabled{opacity:.6}.secondary{background:#e4f1e9;color:#193f33}.muted{font-size:14px;color:#536d5f}#status{background:#fff5dd;padding:12px;border-radius:10px}img{max-width:100%;border-radius:12px}.preview{display:grid;grid-template-columns:1fr 1fr;gap:8px}[hidden]{display:none!important}a{color:#146b57}.request{border-top:1px solid #d4e5db;padding:14px 0;white-space:pre-wrap}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid orange;outline-offset:3px}</style></head><body><main><h1>お店の情報を更新</h1><p>変更を送ると、ふじこが確認して公開します。</p><section id=\"login\"><form id=\"loginForm\"><label for=\"shopId\">お店を選ぶ</label><select id=\"shopId\"><option value=\"SHOP-0001\">おうちcafeパン工房</option><option value=\"SHOP-0002\">ハートネット志木</option><option value=\"SHOP-0003\">ニュータイムス社</option><option value=\"ADMIN\">ふじこ編集長</option></select><label for=\"code\">専用コード</label><input id=\"code\" type=\"password\" autocomplete=\"current-password\" required><p class=\"muted\">お店にお渡ししたコードを入力してください。コードはほかの人に教えないでください。</p><button>更新画面を開く</button></form></section><section id=\"editor\" hidden><h2 id=\"shopName\"></h2><label for=\"kind\">何を変えますか？</label><select id=\"kind\"><option value=\"info\">1 お店の情報を直す</option><option value=\"media\">2 写真・動画を載せる</option><option value=\"notice\">3 今日のお知らせを出す</option></select><form id=\"editForm\"><div id=\"infoFields\"></div><div id=\"mediaFields\" hidden><label for=\"photos\">スマホから写真を選ぶ（4枚まで）</label><input id=\"photos\" type=\"file\" accept=\"image/*\" multiple><div class=\"preview\" id=\"previews\"></div><label for=\"video\">動画のリンク（任意）</label><input id=\"video\" type=\"url\" placeholder=\"YouTubeなどの動画URL\"><p class=\"muted\">写真はスマホから選べます。動画はYouTube・Instagram・Facebookのリンクを貼ってください。</p></div><div id=\"noticeFields\" hidden><label for=\"noticeTitle\">お知らせのタイトル</label><input id=\"noticeTitle\" maxlength=\"80\"><label for=\"noticeBody\">お知らせの本文</label><textarea id=\"noticeBody\" maxlength=\"1500\"></textarea><label for=\"noticeEnd\">いつまで載せる？（任意）</label><input id=\"noticeEnd\" type=\"date\"><p class=\"muted\">特典の内容・条件・期間は、お店で実施するものだけを書いてください。</p></div><button id=\"submit\">確認をお願いして送る</button></form></section><section id=\"admin\" hidden><h2>ふじこの確認待ち</h2><div id=\"requests\"></div></section><p id=\"status\" role=\"status\" aria-live=\"polite\" hidden></p><a href=\"https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/\" target=\"_top\">⌂ DXトップへ戻る</a></main><script>\nconst $=id=>document.getElementById(id);let session=null,photos=[];const fields=['店名','業種','住所','紹介文','おすすめ商品・サービス','営業時間','定休日','電話番号','公式サイトURL','Instagram URL','Facebook URL','LINE公式URL','YouTube URL','店主のひと言'];\nfunction status(t){$('status').hidden=false;$('status').textContent=t;}function busy(on){document.querySelectorAll('button').forEach(b=>b.disabled=on);}function fail(e){busy(false);status(e.message||String(e));}\nfunction rpc(name,args,done){busy(true);google.script.run.withSuccessHandler(r=>{busy(false);done(r);}).withFailureHandler(fail)[name](...args);}\n$('loginForm').onsubmit=e=>{e.preventDefault();const id=$('shopId').value,code=$('code').value.trim();rpc('merchantLogin',[id,code],r=>{session={id,code};$('login').hidden=true;if(r.admin){$('admin').hidden=false;renderRequests(r.requests);}else{$('editor').hidden=false;$('shopName').textContent=r.shop['店名'];$('infoFields').replaceChildren();fields.forEach((k,i)=>{const label=document.createElement('label');label.htmlFor='field'+i;label.textContent=k;const input=document.createElement(k==='紹介文'||k==='おすすめ商品・サービス'?'textarea':'input');input.id='field'+i;input.dataset.field=k;input.value=r.shop[k]||'';input.maxLength=k==='紹介文'?1500:500;$('infoFields').append(label,input);});}status('更新する内容を選んでください。');});};\n$('kind').onchange=()=>{['info','media','notice'].forEach(k=>$(k+'Fields').hidden=$('kind').value!==k);};\n$('photos').onchange=async()=>{photos=[];$('previews').replaceChildren();const files=[...$('photos').files];if(files.length>4){$('photos').value='';status('写真は4枚まで選んでください。');return;}busy(true);try{for(const f of files){const im=await createImageBitmap(f);const canvas=document.createElement('canvas');const ratio=Math.min(1,1000/Math.max(im.width,im.height));canvas.width=Math.round(im.width*ratio);canvas.height=Math.round(im.height*ratio);canvas.getContext('2d').drawImage(im,0,0,canvas.width,canvas.height);let q=.76,data=canvas.toDataURL('image/jpeg',q);while(data.length>230000&&q>.25){q-=.1;data=canvas.toDataURL('image/jpeg',q);}im.close();if(data.length>240000)throw Error('写真が大きすぎます。別の写真を選んでください。');photos.push(data);const img=document.createElement('img');img.src=data;img.alt='送信する写真';$('previews').append(img);}status(photos.length+'枚を選びました。まだ送信されていません。');}catch(e){photos=[];$('photos').value='';$('previews').replaceChildren();status('写真を読み込めませんでした。JPEGなどの別の写真でお試しください。');}busy(false);};\n$('editForm').onsubmit=e=>{e.preventDefault();const type=$('kind').value;let p={};if(type==='info')document.querySelectorAll('[data-field]').forEach(i=>p[i.dataset.field]=i.value);if(type==='notice')p={title:$('noticeTitle').value,body:$('noticeBody').value,end:$('noticeEnd').value};if(type==='media')p={photos,video:$('video').value};rpc('merchantSubmit',[session.id,session.code,type,p],r=>{status(r.message+' 受付番号：'+r.id);$('submit').textContent='続けて別の変更を送る';});};\nfunction renderRequests(rows){$('requests').replaceChildren();if(!rows.length){$('requests').textContent='確認待ちはありません。';return;}rows.forEach(r=>{const box=document.createElement('div');box.className='request';const text=document.createElement('p');text.textContent=r.shop+' / '+({info:'お店の情報',media:'写真・動画',notice:'お知らせ'}[r.type])+'\\n'+r.date+'\\n'+JSON.stringify(r.payload,null,2);box.append(text);(r.previews||[]).forEach(src=>{const img=document.createElement(\"img\");img.src=src;img.alt=\"申請された写真\";box.append(img);});const label=document.createElement('label'),check=document.createElement('input');check.type='checkbox';check.style.width='auto';label.append(check,document.createTextNode('店舗の掲載許可と内容を確認しました'));box.append(label);for(const approve of [true,false]){const btn=document.createElement('button');btn.type='button';btn.textContent=approve?'確認して公開する':'見送る';if(!approve)btn.className='secondary';btn.onclick=()=>rpc('merchantDecide',[session.code,r.id,approve,check.checked],res=>{renderRequests(res.requests);status(approve?'公開しました。':'見送りにしました。');});box.append(btn);}$('requests').append(box);});}\n</script></body></html>\n";

/* Article revisions: all public reads exclude pending/rejected records. */
function postSheet_(){return omSheet_('投稿記事',['受付ID','記事ID','店舗ID','日時','状態','内容JSON','処理日時']);}
function postRows_(){return postSheet_().getDataRange().getDisplayValues().slice(1).filter(r=>r[0]);}
function postNow_(){return Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd HH:mm:ss');}
function postPayload_(r,images){const p=JSON.parse(r[5]);return {request:r[0],id:r[1],shop:r[2],date:r[3],status:r[4],...p,photos:images?omImageData_(p.photos||[]):p.photos||[]};}
function postOwn(id,code){omAuth_(id,code);const rows=postRows_();if(id==='ADMIN')return rows.filter(r=>r[4]==='確認待ち').map(r=>postPayload_(r,true));const latest={};rows.filter(r=>r[2]===id).forEach(r=>latest[r[1]]=r);return Object.values(latest).reverse().map(r=>postPayload_(r,true));}
function postLogin(id,code){const login=merchantLogin(id,code);return {...login,posts:postOwn(id,code),shops:omBook_().getSheetByName('店舗一覧').getDataRange().getDisplayValues().slice(1).filter(r=>r[0]&&r[2]).map(r=>({id:r[0],name:r[2]}))};}
function postSend(id,code,input){
 omAuth_(id,code);if(id==='ADMIN')throw Error('お店を選んで投稿してください。');omShop_(id);
 const body=omText_(input.body,1500),kind=input.kind,end=omText_(input.end,10),ended=input.ended===true;
 if(!['notice','deal'].includes(kind)||!body)throw Error('投稿の種類とひと言を確認してください。');if(end&&!/^\d{4}-\d{2}-\d{2}$/.test(end))throw Error('終了日を確認してください。');
 const photos=input.photos||[];if(!Array.isArray(photos)||photos.length>4||photos.some(v=>!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(v)||v.length>240000))throw Error('写真は4枚まで選んでください。');
 const video=input.video||'';if(video&&(!/^data:video\/(mp4|webm|quicktime);base64,[A-Za-z0-9+/=]+$/i.test(video)||video.length>35000000))throw Error('動画は25MB以内のMP4・MOV・WebMにしてください。');
 const poster=input.poster||'';if(poster&&(!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(poster)||poster.length>240000))throw Error('動画の表紙を確認してください。');
 const lock=LockService.getScriptLock();lock.waitLock(20000);try{
 const rows=postRows_(),previous=input.id?rows.filter(r=>r[1]===input.id).pop():null;
 if(input.id&&(!previous||previous[2]!==id))throw Error('この記事は修正できません。');if(previous&&previous[0]!==input.revision)throw Error('記事が更新されています。一覧を開き直してください。');
 const pid=previous?previous[1]:'POST-'+Utilities.getUuid(),rid='REV-'+Utilities.getUuid(),p={kind,body,end,ended,photos:[]};
 const chunks=omSheet_('店主画像データ',['画像ID','分割番号','データ']);photos.forEach((v,i)=>{const key=rid+'-'+i,parts=[];for(let j=0;j<v.length;j+=35000)parts.push([key,parts.length,v.slice(j,j+35000)]);chunks.getRange(chunks.getLastRow()+1,1,parts.length,3).setValues(parts);p.photos.push(key);});
 const old=previous?JSON.parse(previous[5]):{};
 if(input.keepVideo&&old.videoFileId){p.videoFileId=old.videoFileId;p.poster=old.poster||'';}
 if(video){const match=video.match(/^data:([^;]+);base64,(.+)$/i),file=postVideoFolder_().createFile(Utilities.newBlob(Utilities.base64Decode(match[2]),match[1],rid+(match[1].toLowerCase()==='video/quicktime'?'.mov':'.mp4')));p.videoFileId=file.getId();p.poster=poster;}
 postSheet_().appendRow([rid,pid,id,postNow_(),'確認待ち',JSON.stringify(p),'']);return {ok:true,id:pid,request:rid,status:'確認待ち',posts:postOwn(id,code)};
 }finally{lock.releaseLock();}
}
function postVideoFolder_(){const props=PropertiesService.getScriptProperties(),id=props.getProperty('postVideoFolder');if(id)return DriveApp.getFolderById(id);const folder=DriveApp.createFolder('お店めぐりDX 投稿動画');props.setProperty('postVideoFolder',folder.getId());return folder;}
function postApprove(code,rid,approve){omAuth_('ADMIN',code);const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=postSheet_(),rows=s.getDataRange().getDisplayValues(),i=rows.findIndex(r=>r[0]===rid);if(i<1||rows[i][4]!=='確認待ち')throw Error('処理済みです。');const r=rows[i],p=JSON.parse(r[5]);if(approve){const newer=rows.slice(i+1).some(x=>x[1]===r[1]);if(newer)throw Error('新しい申請があります。新しい内容を確認してください。');if(p.videoFileId)DriveApp.getFileById(p.videoFileId).setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);}s.getRange(i+1,5).setValue(approve?'公開':'見送り');s.getRange(i+1,7).setValue(postNow_());return {ok:true,posts:postOwn('ADMIN',code)};}finally{lock.releaseLock();}}
function postFeed_(params){const latest={};postRows_().filter(r=>r[4]==='公開').forEach(r=>latest[r[1]]=r);const today=postNow_().slice(0,10);let rows=Object.values(latest).filter(r=>{const p=JSON.parse(r[5]);return !p.ended&&(!p.end||p.end>=today)&&(!params.shop||r[2]===params.shop)&&(!params.kind||p.kind===params.kind)&&(!params.id||r[1]===params.id);}).sort((a,b)=>b[3].localeCompare(a[3])||b[0].localeCompare(a[0]));const offset=Math.max(0,Math.min(10000,parseInt(params.offset||'0',10)||0));const total=rows.length;rows=rows.slice(offset,offset+10);return {ok:true,total,offset,posts:rows.map(r=>{const p=postPayload_(r,true);delete p.request;const shop=omShop_(r[2]);p.name=shop['店名'];p.address=shop['住所'];delete p.videoFileId;if(JSON.parse(r[5]).videoFileId)p.video='https://drive.google.com/file/d/'+encodeURIComponent(JSON.parse(r[5]).videoFileId)+'/preview';return p;})};}
function setupPosts(){postSheet_();postVideoFolder_();console.log('投稿記事と動画保存先の準備完了');}

const POST_EDITOR_HTML="<!doctype html><html lang=\"ja\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>お店から投稿する</title><style>*{box-sizing:border-box}body{background:#f5f8f4;color:#193f33;margin:0;font:17px/1.7 -apple-system,BlinkMacSystemFont,sans-serif}main{max-width:620px;margin:auto;padding:18px 16px 90px}section,article{background:white;border:1px solid #d4e5db;border-radius:16px;padding:20px;margin:18px 0}h1{font-size:25px}h2{font-size:21px}input,select,textarea,button{font:inherit}input,select,textarea{max-width:100%;width:100%;padding:12px;border:1px solid #a8c8b7;border-radius:10px}label{display:block;font-weight:700;margin-top:16px}textarea{min-height:140px}button,.btn{display:inline-block;text-decoration:none;min-height:48px;background:#146b57;color:white;border:0;border-radius:12px;padding:12px 16px;font-weight:700;cursor:pointer}.wide{width:100%;margin-top:14px}.secondary{background:#e4f1e9;color:#193f33}.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1}.muted{color:#5c7066;font-size:14px}.body{white-space:pre-wrap;overflow-wrap:anywhere}.status{background:#fff2cf;padding:12px;border-radius:10px}img,video,iframe{display:block;width:100%;max-height:480px;object-fit:contain;border:0;border-radius:12px;margin:12px 0}iframe{height:400px}button:disabled{opacity:.5}[hidden]{display:none!important}.home{position:fixed;bottom:8px;left:50%;transform:translateX(-50%);width:calc(100% - 28px);max-width:360px;text-align:center;padding:10px 16px;font-size:16px;border:2px solid white;border-radius:12px;background:#146b57;color:white;text-decoration:none}</style></head><body><main><h1>お店から投稿する</h1><p id=\"status\" class=\"status\" role=\"status\" hidden></p>\n<section id=\"login\"><form id=\"loginForm\"><label for=\"shop\">お店</label><select id=\"shop\"><option value=\"SHOP-0002\">ハートネット志木</option><option value=\"SHOP-0001\">おうちcafeパン工房</option><option value=\"SHOP-0003\">ニュータイムス社</option><option value=\"ADMIN\">ふじこ編集長</option></select><label for=\"code\">専用コード</label><input id=\"code\" type=\"password\" autocomplete=\"current-password\" required><button class=\"wide\">自分のページを開く</button></form></section>\n<div id=\"owner\" hidden><h2 id=\"shopName\"></h2><section id=\"composer\"><h2>投稿を書く</h2><form id=\"postForm\"><label for=\"kind\">投稿の種類</label><select id=\"kind\"><option value=\"notice\">お知らせ</option><option value=\"deal\">お得情報</option></select><label for=\"body\">ひと言書く</label><textarea id=\"body\" required maxlength=\"1500\"></textarea><label for=\"files\">写真・動画を選ぶ（任意）</label><input id=\"files\" type=\"file\" accept=\"image/*,video/*\" multiple><p class=\"muted\">写真4枚・動画1本まで。動画は25MBまで。</p><p id=\"chosen\" class=\"muted\"></p><details><summary>掲載終了日（任意）</summary><input id=\"end\" type=\"date\" aria-label=\"掲載終了日\"></details><button class=\"wide\">投稿内容を確認する</button><button id=\"cancel\" class=\"wide secondary\" type=\"button\" hidden>修正をやめる</button></form></section><section id=\"ownList\"><h2>自分の投稿</h2><div id=\"ownPosts\"></div></section></div>\n<section id=\"review\" hidden><h2 id=\"reviewTitle\">この内容で投稿しますか？</h2><p id=\"reviewState\" class=\"status\"></p><div id=\"article\"></div><div id=\"reviewActions\"><button id=\"send\" class=\"wide\">この内容で投稿する</button><button id=\"rewrite\" class=\"wide secondary\">書き直す</button></div><div id=\"completeActions\" hidden><a id=\"viewPublic\" class=\"btn wide\" target=\"_blank\" rel=\"noopener\">公開された記事を見る</a><p id=\"pendingNote\" class=\"muted\">ふじこが確認すると、お店のページとタイムラインに表示されます。</p><button id=\"back\" class=\"wide secondary\">自分の投稿へ戻る</button></div></section>\n<section id=\"admin\" hidden><h2>ふじこの確認待ち</h2><div id=\"requests\"></div></section>\n</main><a class=\"home\" href=\"https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/\" target=\"_top\">⌂ DXトップへ戻る</a><script>\nconst $=id=>document.getElementById(id),base='https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/';let session=null,own=[],editing=null,draft=null,busyFlag=false,objectURLs=[];\nfunction status(text){$('status').textContent=text;$('status').hidden=false;}function busy(v){busyFlag=v;document.querySelectorAll('button').forEach(b=>b.disabled=v);}function rpc(name,args){busy(true);return new Promise((resolve,reject)=>google.script.run.withSuccessHandler(r=>{busy(false);resolve(r);}).withFailureHandler(e=>{busy(false);status(e.message||String(e));reject(e);})[name](...args));}\nfunction el(tag,text,cls){const n=document.createElement(tag);if(text)n.textContent=text;if(cls)n.className=cls;return n;}\nfunction media(box,p){(p.photos||[]).forEach(src=>{if(!/^data:image\\/jpeg;base64,/.test(src))return;const im=el('img');im.src=src;im.alt='投稿の写真';box.append(im);});if(p.video||p.videoFileId){const cover=el('div'),play=el('button','▶ 動画を見る','wide secondary');if(p.poster){const img=el('img');img.src=p.poster;img.alt='動画の表紙';cover.append(img);}play.type='button';play.onclick=()=>{play.disabled=true;const frame=el('iframe');frame.src=p.video||'https://drive.google.com/file/d/'+encodeURIComponent(p.videoFileId)+'/preview';frame.title='投稿動画';frame.allow='autoplay; fullscreen';frame.allowFullscreen=true;cover.replaceChildren(frame);};cover.append(play);box.append(cover);}}\nfunction article(box,p){box.replaceChildren();box.append(el('h2',p.name||$('shopName').textContent),el('p',p.kind==='deal'?'お得情報':'お知らせ','muted'),el('p',p.body,'body'));media(box,p);if(p.end)box.append(el('p',p.end+'まで','muted'));}\n$('loginForm').onsubmit=async e=>{e.preventDefault();try{const id=$('shop').value,code=$('code').value.trim(),r=await rpc('postLogin',[id,code]);session={id,code};$('login').hidden=true;$('code').value='';$('status').hidden=true;if(id==='ADMIN'){$('admin').hidden=false;renderAdmin(r.posts);}else{own=r.posts;$('shopName').textContent=r.shop['店名'];$('owner').hidden=false;renderOwn();}}catch{}};\nfunction renderOwn(){$('ownPosts').replaceChildren();if(!own.length)$('ownPosts').append(el('p','まだ投稿はありません。'));own.forEach(p=>{const box=el('article');box.append(el('p',p.status+(p.ended?'・掲載終了':''),'muted'),el('p',p.body.split('\\n')[0]));const row=el('div',null,'row');for(const [text,fn] of [['記事を見る',()=>show(p,false)],['直す',()=>edit(p)],['掲載終了',()=>endPost(p)]]){const b=el('button',text,'secondary');b.onclick=fn;row.append(b);}box.append(row);$('ownPosts').append(box);});}\nfunction reset(){editing=null;draft=null;$('postForm').reset();$('chosen').textContent='';$('cancel').hidden=true;}\nfunction edit(p){editing=p;$('owner').hidden=false;$('review').hidden=true;$('body').value=p.body;$('kind').value=p.kind;$('end').value=p.end||'';$('files').value='';$('chosen').textContent='写真・動画はそのまま残ります。別のものを選ぶと差し替えます。';$('cancel').hidden=false;$('composer').scrollIntoView();}\n$('cancel').onclick=reset;\n$('files').onchange=()=>{$('chosen').textContent=[...$('files').files].map(f=>f.name).join('、');};\nfunction dataURL(blob){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(blob);});}\nasync function photo(file){const im=await createImageBitmap(file),canvas=document.createElement('canvas'),r=Math.min(1,1000/Math.max(im.width,im.height));canvas.width=Math.round(im.width*r);canvas.height=Math.round(im.height*r);canvas.getContext('2d').drawImage(im,0,0,canvas.width,canvas.height);im.close();let q=.75,s=canvas.toDataURL('image/jpeg',q);while(s.length>230000&&q>.25){q-=.1;s=canvas.toDataURL('image/jpeg',q);}if(s.length>240000)throw Error('写真が大きすぎます。別の写真を選んでください。');return s;}\nasync function videoPoster(file){return new Promise(resolve=>{const v=document.createElement('video'),url=URL.createObjectURL(file);v.muted=true;v.playsInline=true;let done=false;const finish=value=>{if(done)return;done=true;URL.revokeObjectURL(url);resolve(value);};v.onloadedmetadata=()=>v.currentTime=Math.min(.1,(v.duration||1)/2);v.onseeked=()=>{try{const c=document.createElement('canvas'),r=Math.min(1,480/v.videoWidth);c.width=Math.round(v.videoWidth*r);c.height=Math.round(v.videoHeight*r);c.getContext('2d').drawImage(v,0,0,c.width,c.height);finish(c.toDataURL('image/jpeg',.65));}catch{finish('');}};v.onerror=()=>finish('');v.src=url;setTimeout(()=>finish(''),5000);});}\n$('postForm').onsubmit=async e=>{e.preventDefault();if(busyFlag)return;busy(true);try{const files=[...$('files').files],images=files.filter(f=>f.type.startsWith('image/')),videos=files.filter(f=>f.type.startsWith('video/'));if(images.length>4||videos.length>1||images.length+videos.length!==files.length)throw Error('写真4枚・動画1本まで選べます。');if(videos[0]?.size>25*1024*1024)throw Error('動画は25MB以内の短い動画を選んでください。');const photos=files.length?await Promise.all(images.map(photo)):(editing?.photos||[]);draft={id:editing?.id||'',revision:editing?.request||'',kind:$('kind').value,body:$('body').value.trim(),end:$('end').value,photos,keepVideo:!files.length&&!!editing?.videoFileId};if(videos.length){draft.video=await dataURL(videos[0]);draft.poster=await videoPoster(videos[0]);}const preview={...draft,videoFileId:draft.keepVideo?editing.videoFileId:''};if(draft.video){const blob=videos[0],url=URL.createObjectURL(blob);objectURLs.push(url);preview.video=url;}show(preview,true);$('status').hidden=true;}catch(e){status(e.message||'写真・動画を読み込めませんでした。');}finally{busy(false);}};\nfunction show(p,review){$('owner').hidden=true;$('review').hidden=false;article($('article'),p);$('reviewTitle').textContent=review?'この内容で投稿しますか？':'自分のお店の投稿';$('reviewState').textContent=review?'まだ投稿されていません。見え方を確認して、最後に投稿してください。':p.status==='公開'?'公開済みです':p.status==='見送り'?'見送り：内容を直して投稿できます。':'投稿受付済み・ふじこの確認待ちです。';$('reviewActions').hidden=!review;$('completeActions').hidden=review;$('viewPublic').hidden=review||p.status!=='公開';$('viewPublic').href=base+'article.html?id='+encodeURIComponent(p.id||'');$('pendingNote').hidden=p.status==='公開';$('review').scrollIntoView();}\n$('rewrite').onclick=()=>{$('review').hidden=true;$('owner').hidden=false;$('composer').scrollIntoView();};\n$('send').onclick=async()=>{if(!draft||busyFlag)return;status('送信しています。このままお待ちください。');try{const r=await rpc('postSend',[session.id,session.code,draft]);own=r.posts;const p=own.find(p=>p.id===r.id);reset();renderOwn();show(p,false);$('reviewTitle').textContent='投稿を受け付けました';$('status').hidden=true;}catch{}};\n$('back').onclick=async()=>{try{own=await rpc('postOwn',[session.id,session.code]);$('review').hidden=true;$('owner').hidden=false;renderOwn();$('ownList').scrollIntoView();$('status').hidden=true;}catch{}};\nasync function endPost(p){try{const r=await rpc('postSend',[session.id,session.code,{id:p.id,revision:p.request,kind:p.kind,body:p.body,end:p.end||'',photos:p.photos||[],keepVideo:!!p.videoFileId,ended:true}]);own=r.posts;renderOwn();status('掲載終了を受け付けました。ふじこが確認すると一覧から下がります。');}catch{}}\nfunction renderAdmin(rows){$('requests').replaceChildren();if(!rows.length)$('requests').append(el('p','確認待ちはありません。'));rows.forEach(p=>{const box=el('article');p.name=p.shop;article(box,p);box.prepend(el('p',p.date+(p.ended?'・掲載終了申請':''),'muted'));const label=el('label'),check=el('input');check.type='checkbox';check.style.width='auto';label.append(check,document.createTextNode('掲載内容を確認しました'));box.append(label);const publish=el('button','確認して公開','wide');publish.onclick=async()=>{if(!check.checked){status('掲載内容を確認してチェックしてください。');return;}try{const r=await rpc('postApprove',[session.code,p.request,true]);renderAdmin(r.posts);status('公開しました。DXのタイムラインとお店のページに反映されます。');}catch{}};const reject=el('button','見送る','wide secondary');reject.onclick=async()=>{try{const r=await rpc('postApprove',[session.code,p.request,false]);renderAdmin(r.posts);status('見送りにしました。');}catch{}};box.append(publish,reject);$('requests').append(box);});}\n</script></body></html>\n";

