/** 店舗共通の紹介4枠。運営が初期登録し、各店が同じ画面で更新する。 */
function omScenesTarget_(id,code,target){
 omAuth_(id,code);const shopId=id==='ADMIN'?String(target||''):id;
 if(!/^SHOP-[0-9]{4}$/.test(shopId))throw Error('お店を選んでください。');
 omShop_(shopId);return shopId;
}
function omScenesRead_(id){
 const sheet=omBook_().getSheetByName('店舗紹介4枠');
 const rows=sheet?sheet.getDataRange().getDisplayValues().slice(1):[];
 const row=rows.filter(r=>r[0]===id).pop();
 let scenes=row?JSON.parse(row[2]):JSON.parse(JSON.stringify(OM_SCENE_DEFAULTS_[id]||Array.from({length:4},()=>({title:'',src:'',body:'',alt:'',illustration:false}))));
 // Older approved photo replacements retain their four slot titles and text.
 if(!row){const legacy=omBook_().getSheetByName('店主申請');const media=legacy?legacy.getDataRange().getDisplayValues().slice(1).filter(r=>r[2]===id&&r[3]==='media'&&r[4]==='公開').pop():null;
 if(media){const p=JSON.parse(media[6]||'{}');const pictures=omImageData_(p.photos||[]);pictures.forEach((src,i)=>{if(i<4&&src)scenes[i]={...scenes[i],src:src,illustration:false};});}}
 const ids=scenes.filter(s=>s.imageId).map(s=>s.imageId),data=omImageData_(ids);let i=0;
 scenes=scenes.map(s=>s.imageId?{title:s.title,body:s.body,alt:s.alt,illustration:!!s.illustration,src:data[i++]||''}:s);
 return {revision:row?row[1]:'initial',scenes:scenes};
}
function merchantScenesGet(id,code,target){const shopId=omScenesTarget_(id,code,target);return {ok:true,shopId:shopId,name:omShop_(shopId)['店名'],...omScenesRead_(shopId)};}
function merchantScenesSave(id,code,target,p){
 const shopId=omScenesTarget_(id,code,target);
 if(!p||!Array.isArray(p.scenes)||p.scenes.length!==4)throw Error('紹介は4セットで保存してください。');
 const scenes=p.scenes.map(s=>{const title=omText_(s.title,80),body=omText_(s.body,1500),src=String(s.src||'');
 if(!title||!body||!src)throw Error('4セットすべてのタイトル・画像・説明文を入れてください。');
 if(!(/^https:\/\/[^\s]+$/i.test(src)||(/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(src)&&src.length<=240000)))throw Error('写真の形式やサイズを確認してください。');
 return {title:title,body:body,src:src,alt:omText_(s.alt||title,200),illustration:!!s.illustration};});
 const lock=LockService.getScriptLock();lock.waitLock(20000);try{
 const current=omScenesRead_(shopId);if(p.revision!==current.revision)throw Error('別の画面で更新されています。画面を開き直して最新内容を確認してください。');
 const revision=Utilities.getUuid(),blobs=omSheet_('店主画像データ',['画像ID','分割番号','データ']);
 const master=omBook_().getSheetByName('店舗一覧'),shopRows=master.getDataRange().getDisplayValues(),headers=shopRows[0],row=shopRows.findIndex(r=>r[headers.indexOf('店舗ID')]===shopId),photoCol=headers.indexOf('写真URL');
 let coverURL=null;
 if(row>0&&photoCol>=0&&scenes[0].src!==current.scenes[0].src){
  coverURL=scenes[0].src;
  if(coverURL.startsWith('data:')){const match=coverURL.match(/^data:([^;]+);base64,(.+)$/),file=postSocialFolder_().createFile(Utilities.newBlob(Utilities.base64Decode(match[2]),match[1],'COVER-'+shopId+'-'+revision+'.jpg'));postShareFile_(file.getId());coverURL='https://lh3.googleusercontent.com/d/'+encodeURIComponent(file.getId())+'=w600';}
 }

 const stored=scenes.map((s,i)=>{if(!s.src.startsWith('data:'))return s;
 const imageId='SCENE-'+revision+'-'+i,parts=[];for(let j=0;j<s.src.length;j+=35000)parts.push([imageId,parts.length,s.src.slice(j,j+35000)]);
 blobs.getRange(blobs.getLastRow()+1,1,parts.length,3).setValues(parts);
 return {title:s.title,body:s.body,alt:s.alt,illustration:s.illustration,imageId:imageId};});
 const sheet=omSheet_('店舗紹介4枠',['店舗ID','改訂ID','内容JSON','更新日時']);const rows=sheet.getDataRange().getDisplayValues();const index=rows.findIndex(r=>r[0]===shopId);
 const values=[shopId,revision,JSON.stringify(stored),Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd HH:mm:ss')];
 if(index>0)sheet.getRange(index+1,1,1,4).setValues([values]);else sheet.appendRow(values);

 if(row>0){if(coverURL!==null)master.getRange(row+1,photoCol+1).setValue(coverURL);[['公開状態','公開'],['掲載許可','確認済み']].forEach(([key,value])=>{const col=headers.indexOf(key);if(col>=0)master.getRange(row+1,col+1).setValue(value);});}
 return {ok:true,revision:revision,scenes:scenes,message:'保存しました。お店の紹介ページと一覧に反映しました。'};
 }finally{lock.releaseLock();}
}

const SCENES_HTML="<!doctype html><html lang=\"ja\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>お店の紹介を直す</title><style>\n*{box-sizing:border-box}body{margin:0;background:#f5f8f4;color:#193f33;font:17px/1.8 -apple-system,BlinkMacSystemFont,sans-serif}main{max-width:650px;margin:auto;padding:18px 16px 70px}section,article{background:#fff;padding:20px;border:1px solid #d4e5db;border-radius:16px;margin:18px 0}h1{font-size:25px}h2{font-size:22px}h3{font-size:21px}label{display:block;font-weight:700;margin-top:16px}input,textarea,select,button,.btn{font:inherit;width:100%;padding:12px;border:1px solid #a8c8b7;border-radius:10px}textarea{min-height:120px}button,.btn{display:block;text-align:center;text-decoration:none;background:#146b57;color:white;margin-top:16px;font-weight:700;cursor:pointer;min-height:48px}button:disabled{opacity:.5;cursor:wait}.secondary{background:#e4f1e9;color:#193f33}img{width:100%;height:auto;border-radius:12px;margin:12px 0}p{white-space:pre-wrap}a{color:#146b57}.muted{font-size:14px;color:#536d5f}.status{background:#fff5dd;padding:12px;border-radius:10px}[hidden]{display:none!important}:focus-visible{outline:3px solid orange;outline-offset:3px}</style></head><body><main><a href=\"https://script.google.com/macros/s/AKfycbzMec1R3le4e-cOUyBUl6Eq2dU3OI-5HHtkEyJQT7SWx4IjUHGtW8Z3zatJxoA2GUhn2A/exec?mode=edit\" target=\"_top\">← お店の管理へ</a><h1>お店の紹介を直す</h1><p>タイトル → 画像 → 説明文を4セット。こちらで用意した内容から、変えたいところだけ直せます。</p><p id=\"status\" role=\"status\" aria-live=\"polite\" hidden class=\"status\"></p>\n<button id=\"retryLogin\" class=\"secondary\" type=\"button\" hidden>もう一度接続する</button><section id=\"login\"><p class=\"muted\">このスマホでは30日間ログインを保持します。</p><form id=\"loginForm\"><label for=\"code\">専用コード</label><input id=\"code\" type=\"password\" autocomplete=\"current-password\" required><button>自分のお店を開く</button></form></section>\n<section id=\"admin\" hidden><label for=\"target\">編集するお店</label><select id=\"target\"><option value=\"SHOP-0001\">おうちcafeパン工房</option><option value=\"SHOP-0002\">ハートネット志木</option><option value=\"SHOP-0003\">ニュータイムス社</option></select></section>\n<div id=\"editor\" hidden><h2 id=\"shopName\"></h2><p class=\"muted\">画像を選び直さなければ、今の画像をそのまま使います。</p><form id=\"sceneForm\"><div id=\"fields\"></div><button id=\"previewButton\">プレビューで確認する</button></form></div>\n<section id=\"review\" hidden><button type=\"button\" id=\"backToEditor\" class=\"secondary\">← 情報を直す画面に戻る</button><h2>お客さんに見える内容</h2><p class=\"muted\">まだ保存されていません。</p><div id=\"preview\"></div><button id=\"save\">この内容で保存・公開する</button><button type=\"button\" id=\"rewrite\" class=\"secondary\">← 情報を直す画面に戻る</button></section><a id=\"publicLink\" class=\"btn secondary\" hidden target=\"_blank\" rel=\"noopener\">お店の紹介ページを見る</a></main><script>\n'use strict';\nconst sessionMemory=(()=>{\n const key='shiki-merchant-session-v1';\n const valid=a=>a&&/^(SHOP-[0-9]{4}|ADMIN)$/.test(a.id)&&/^DXS1\\.[a-f0-9]{64}$/.test(a.token)&&Number.isFinite(a.expiresAt)&&a.expiresAt>Date.now();\n return {\n  read(){try{const a=JSON.parse(localStorage.getItem(key)||'null');if(valid(a))return a;if(a)localStorage.removeItem(key);}catch{}return null;},\n  save(a){if(!valid(a))return false;try{localStorage.setItem(key,JSON.stringify({id:a.id,token:a.token,expiresAt:a.expiresAt}));return true;}catch{return false;}},\n  forget(){try{localStorage.removeItem(key);}catch{}},\n  authError(e){return /有効期限|専用コードが違|セッション.*(?:無効|失効)|invalid.*(?:session|token)/i.test(e?.message||String(e));}\n };\n})();\nconst $=id=>document.getElementById(id),base='https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/';let session=null,shopId='',scenes=[],revision='',pending=false,dirty=false,editorScroll=0;\nfunction status(t){$('status').hidden=false;$('status').textContent=t;}\nfunction busy(on){pending=on;document.querySelectorAll('button,input,textarea,select').forEach(e=>e.disabled=on);}\nfunction rpc(name,args){busy(true);return new Promise((resolve,reject)=>google.script.run.withSuccessHandler(r=>{busy(false);resolve(r);}).withFailureHandler(e=>{busy(false);status(e.message||String(e));reject(e);})[name](...args));}\nfunction node(tag,text){const n=document.createElement(tag);if(text)n.textContent=text;return n;}\nfunction setLink(){const slug={'SHOP-0001':'ouchicafe','SHOP-0002':'heartnet','SHOP-0003':'newtimes'}[shopId];$('publicLink').href=base+slug+'.html?updated='+Date.now();$('publicLink').hidden=!slug;}\nasync function load(){if(!session)return;$('retryLogin').hidden=true;try{const r=await rpc('merchantScenesGet',[session.id,session.code,$('target').value]);shopId=r.shopId;scenes=r.scenes;revision=r.revision;dirty=false;$('shopName').textContent=r.name;$('login').hidden=true;$('editor').hidden=false;$('review').hidden=true;render();setLink();status('変えたいところを直して、プレビューで確認してください。');}catch(e){if(sessionMemory.authError(e)){sessionMemory.forget();session=null;$('login').hidden=false;status('ログインの有効期限が切れました。専用コードを入力してください。');}else{$('login').hidden=true;$('retryLogin').hidden=false;status('接続できませんでした。保存したログイン情報と入力内容は残っています。');}}}\nfunction render(){$('fields').replaceChildren();scenes.forEach((s,i)=>{const card=node('article');card.append(node('h2','紹介 '+(i+1)));for(const [key,label,tag] of [['title','タイトル','input'],['src','画像','file'],['body','説明文','textarea']]){const id='scene-'+i+'-'+key,l=node('label',label);l.htmlFor=id;card.append(l);if(tag==='file'){const img=node('img');img.src=s.src;img.alt=s.alt||s.title;card.append(img);const f=node('input');f.type='file';f.accept='image/*';f.id=id;f.onchange=async()=>{if(!f.files[0])return;busy(true);try{const data=await photo(f.files[0]);s.src=data;s.alt=s.title;s.illustration=false;img.src=data;dirty=true;status('画像を差し替えました。まだ保存されていません。');}catch(e){f.value='';status(e.message);}finally{busy(false);}};card.append(f);}else{const input=node(tag);input.id=id;input.maxLength=key==='title'?80:1500;input.required=true;input.value=s[key]||'';input.oninput=()=>{s[key]=input.value;dirty=true;};card.append(input);}}$('fields').append(card);});}\nasync function photo(f){if(!f.type.startsWith('image/'))throw Error('写真を選んでください。');const image=await new Promise((resolve,reject)=>{const im=new Image(),u=URL.createObjectURL(f);im.onload=()=>{URL.revokeObjectURL(u);resolve(im);};im.onerror=()=>{URL.revokeObjectURL(u);reject(Error('画像を読み込めません。JPEGなどの画像を選んでください。'));};im.src=u;});const c=document.createElement('canvas'),r=Math.min(1,1200/Math.max(image.width,image.height));c.width=Math.round(image.width*r);c.height=Math.round(image.height*r);const ctx=c.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,c.width,c.height);ctx.drawImage(image,0,0,c.width,c.height);let data;for(let q=.8;q>=.2;q-=.1){data=c.toDataURL('image/jpeg',q);if(data.length<=240000)return data;}throw Error('写真が大きすぎます。別の写真を選んでください。');}\n$('loginForm').onsubmit=async e=>{e.preventDefault();try{const code=$('code').value.trim(),r=await rpc('postLoginByCode',[code,true]);session={id:r.loginId,code:r.auth?.token||code};const saved=sessionMemory.save(r.auth);if(!saved)status('このブラウザではログインを保存できませんでした。');$('code').value='';$('admin').hidden=session.id!=='ADMIN';await load();}catch{}};\n$('target').onchange=()=>{if(dirty&&!confirm('保存していない変更を閉じて、別のお店を開きますか？')){$('target').value=shopId;return;}load();};\n$('sceneForm').onsubmit=e=>{e.preventDefault();if(pending)return;editorScroll=window.scrollY;$('preview').replaceChildren();scenes.forEach(s=>{const a=node('article'),img=node('img');img.src=s.src;img.alt=s.alt||s.title;a.append(node('h3',s.title),img,node('p',s.body));if(s.illustration)a.append(node('p','活動紹介用のイメージ'));$('preview').append(a);});$('editor').hidden=true;$('admin').hidden=true;$('review').hidden=false;$('review').scrollIntoView();};\nfunction returnToEditor(){if(pending)return;$('review').hidden=true;$('editor').hidden=false;$('admin').hidden=session.id!=='ADMIN';$('previewButton').focus({preventScroll:true});window.scrollTo({top:editorScroll,behavior:'instant'});}\n$('rewrite').onclick=returnToEditor;$('backToEditor').onclick=returnToEditor;\n$('save').onclick=async()=>{if(pending)return;try{const r=await rpc('merchantScenesSave',[session.id,session.code,shopId,{revision,scenes}]);revision=r.revision;dirty=false;$('review').hidden=true;$('editor').hidden=false;$('admin').hidden=session.id!=='ADMIN';setLink();status(r.message);$('status').scrollIntoView();}catch{}};\nfunction restoreSceneLogin(){const saved=sessionMemory.read();if(!saved)return;session={id:saved.id,code:saved.token};$('login').hidden=true;$('admin').hidden=saved.id!=='ADMIN';load();}\n$('retryLogin').onclick=()=>{if(session)load();else restoreSceneLogin();};restoreSceneLogin();\nwindow.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue='';}});\n</script></body></html>\n";


/** Authenticated management calls. The same per-store checks as google.script.run apply. */
function ownerVersion_(){return {ok:true,version:'firstparty-owner-v1'};}
function doPost(e){
 try{
  const raw=e&&e.postData&&e.postData.contents;
  if(!raw||raw.length>24000000)throw Error('送信内容を確認してください。');
  const request=JSON.parse(raw);
  if(request.api!=='owner-v1'||!Array.isArray(request.args)||request.args.length>8)throw Error('送信形式を確認してください。');
  // Never dispatch arbitrary global functions, setup routines or private helpers.
  const methods={postLoginByCode:postLoginByCode,postLogin:postLogin,postOwn:postOwn,postSend:postSend,postDelete:postDelete,postLogout:postLogout,thanksCardSet:thanksCardSet,merchantScenesGet:merchantScenesGet,merchantScenesSave:merchantScenesSave,merchantSubmit:merchantSubmit,merchantDecide:merchantDecide};
  if(!Object.prototype.hasOwnProperty.call(methods,request.method))throw Error('この操作には対応していません。');
  const result=methods[request.method].apply(null,request.args);
  return respond_({ok:true,result:result},'');
 }catch(e){return respond_({ok:false,error:e instanceof SyntaxError?'送信形式を確認してください。':String(e&&e.message||'処理を完了できませんでした。')},'');}
}
