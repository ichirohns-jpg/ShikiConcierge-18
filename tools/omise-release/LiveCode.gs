er\"><h2>かんたん投稿</h2><p class=\"muted\">①から③まで順番に入れて、最後に確認ボタンを押してください。</p><p class=\"author\" id=\"composeShop\"></p><form id=\"postForm\"><div class=\"step\"><label for=\"kind\">① 投稿の種類を選ぶ</label><select id=\"kind\"><option value=\"notice\">普通のお知らせ</option><option value=\"deal\">お得情報・特典</option></select></div><div class=\"step\"><label for=\"body\">② 伝えたいことを書く</label><textarea id=\"body\" required maxlength=\"1500\" placeholder=\"例：本日、焼きたてパンができました\"></textarea></div><div class=\"step\"><label for=\"files\" class=\"filelabel\">③ 写真・動画を選ぶ</label><input class=\"sr\" id=\"files\" type=\"file\" accept=\"image/*,video/*\" multiple><p class=\"muted\">写真や動画がない場合は、選ばなくても投稿できます。</p><p id=\"chosen\" class=\"muted\"></p><div id=\"liveMedia\"></div></div><details><summary>掲載終了日を決める場合だけ開く</summary><input id=\"end\" type=\"date\" aria-label=\"掲載終了日\"></details><button class=\"wide confirm\" type=\"submit\">入力内容を確認する</button><button id=\"cancel\" class=\"wide secondary\" type=\"button\" hidden>修正をやめる</button></form></section><section id=\"ownList\"><h2>自分の記事</h2><p class=\"muted\">お知らせもお得情報も、ここから直したり、掲載を終了できます。</p><div id=\"ownPosts\"></div></section></div>\n<section id=\"review\" hidden><h2 id=\"reviewTitle\">この内容で投稿しますか？</h2><p id=\"reviewState\" class=\"status\"></p><div id=\"article\"></div><div id=\"reviewActions\"><button id=\"send\" class=\"wide\">投稿する</button><button id=\"rewrite\" class=\"wide secondary\">書き直す</button></div><div id=\"completeActions\" hidden><a id=\"viewPublic\" class=\"btn wide\" target=\"_blank\" rel=\"noopener\">公開された記事を見る</a><p id=\"pendingNote\" class=\"muted\">投稿は届いています。現在は公開確認待ちです。確認が済むとタイムラインにも表示されます。</p><button id=\"back\" class=\"wide secondary\">自分の記事へ戻る</button></div></section>\n<section id=\"admin\" hidden><h2>ふじこの確認待ち</h2><div id=\"requests\"></div></section>\n<p><a class=\"btn wide secondary\" href=\"https://script.google.com/macros/s/AKfycbzMec1R3le4e-cOUyBUl6Eq2dU3OI-5HHtkEyJQT7SWx4IjUHGtW8Z3zatJxoA2GUhn2A/exec?mode=info\" target=\"_top\">お店の基本情報・地図を直す</a></p></main><nav class=\"admin-nav\" aria-label=\"お店めぐりDX 共通メニュー\"><a href=\"https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/\" target=\"_top\">⌂ DXトップ</a><a href=\"https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/#shops\" target=\"_top\">お店を探す</a><a href=\"https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/timeline.html\" target=\"_top\">投稿を見る</a><a href=\"https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/deals.html\" target=\"_top\">特典を見る</a></nav><script>\nconst $=id=>document.getElementById(id),base='https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/';let session=null,own=[],editing=null,draft=null,busyFlag=false,objectURLs=[];\nconst layout=document.createElement('style');layout.textContent='.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);padding:0;border:0}#composer{padding-top:18px}.author{font-weight:800;font-size:19px;margin:8px 0}.step{padding:14px 0;border-top:1px solid #d4e5db}.step label{font-size:19px;margin:0 0 8px}#kind{background:#fff;border:2px solid #99baa9;font-size:18px}#body{min-height:150px;font-size:19px;line-height:1.65}.filelabel{display:block;border:2px solid #146b57;border-radius:12px;padding:14px;color:#146b57;text-align:center;cursor:pointer;background:#eef6f2}.confirm{font-size:19px;min-height:58px}details{margin-top:14px}summary{font-weight:700;cursor:pointer}#liveMedia img{max-height:none}#status{position:sticky;top:0;z-index:9;border:2px solid #c8931e}';document.head.append(layout);new MutationObserver(()=>$('composeShop').textContent=$('shopName').textContent).observe($('shopName'),{childList:true});$('body').addEventListener('input',()=>{$('body').style.height='auto';$('body').style.height=Math.max(170,$('body').scrollHeight)+'px';});\nfunction status(text){$('status').textContent=text;$('status').hidden=false;$('status').scrollIntoView({block:'start'});}function busy(v){busyFlag=v;document.querySelectorAll('button').forEach(b=>b.disabled=v);}function rpc(name,args){busy(true);return new Promise((resolve,reject)=>google.script.run.withSuccessHandler(r=>{busy(false);resolve(r);}).withFailureHandler(e=>{busy(false);status(e.message||String(e));reject(e);})[name](...args));}\nfunction el(tag,text,cls){const n=document.createElement(tag);if(text)n.textContent=text;if(cls)n.className=cls;return n;}\nfunction media(box,p){(p.photos||[]).forEach(src=>{if(!/^data:image\\/jpeg;base64,/.test(src))return;const im=el('img');im.src=src;im.alt='投稿の写真';box.append(im);});if(p.video||p.videoFileId){const cover=el('div'),play=el('button','▶ 動画を見る','wide secondary');if(p.poster){const img=el('img');img.src=p.poster;img.alt='動画の表紙';cover.append(img);}play.type='button';play.onclick=()=>{play.disabled=true;if(p.video?.startsWith('blob:')){const v=el('video');v.src=p.video;v.controls=true;v.playsInline=true;cover.replaceChildren(v);v.play().catch(()=>{});return;}const frame=el('iframe');frame.src=p.video||'https://drive.google.com/file/d/'+encodeURIComponent(p.videoFileId)+'/preview';frame.title='投稿動画';frame.allow='autoplay; fullscreen';frame.allowFullscreen=true;cover.replaceChildren(frame);};cover.append(play);box.append(cover);}}\nfunction article(box,p){box.replaceChildren();box.append(el('h2',p.name||$('shopName').textContent),el('p',p.kind==='deal'?'お得情報':'お知らせ','muted'),el('p',p.body,'body'));media(box,p);if(p.end)box.append(el('p',p.end+'まで','muted'));}\nconst rememberKey='shiki-merchant-session-v1';\nfunction forgetLogin(){try{localStorage.removeItem(rememberKey);}catch{}}\nfunction readLogin(){try{const saved=JSON.parse(localStorage.getItem(rememberKey)||'null');if(saved&&/^(SHOP-[0-9]{4}|ADMIN)$/.test(saved.id)&&/^DXS1\\.[a-f0-9]{64}$/.test(saved.token)&&Number.isFinite(saved.expiresAt)&&saved.expiresAt>Date.now())return saved;}catch{}forgetLogin();return null;}\nfunction enterOwnPage(id,credential,r,keep){\n const auth=r.auth;\n // Only the revocable session token, never the dedicated code, is persisted.\n const valid=auth&&auth.id===id&&/^DXS1\\.[a-f0-9]{64}$/.test(auth.token)&&Number.isFinite(auth.expiresAt)&&auth.expiresAt>Date.now();\n session={id,code:valid?auth.token:credential};\n let saved=false;forgetLogin();if(keep&&valid){try{localStorage.setItem(rememberKey,JSON.stringify(auth));saved=true;}catch{}}\n $('login').hidden=true;$('code').value='';$('status').hidden=true;$('account').hidden=false;\n $('accountName').textContent=id==='ADMIN'?'ふじこ編集長':r.shop['店名'];$('locationName').textContent='現在：'+$('accountName').textContent+'の管理';\n if(id==='ADMIN'){$('admin').hidden=false;renderAdmin(r.posts);}else{own=r.posts;$('shopName').textContent=r.shop['店名'];$('adMaker').href=base+'ad-maker.html?name='+encodeURIComponent(r.shop['店名']);$('owner').hidden=false;renderOwn();}\n if(keep&&!saved)status('このブラウザではログインを保持できませんでした。この画面では引き続き使えます。');\n}\n$('loginForm').onsubmit=async e=>{e.preventDefault();if(busyFlag)return;try{const code=$('code').value.trim(),keep=$('remember').checked,r=await rpc('postLoginByCode',[code,keep]);enterOwnPage(r.loginId,code,r,keep);}catch{}};\n$('logout').onclick=async()=>{\n if(busyFlag)return;\n if(draft||editing||$('body').value.trim()||$('files').files.length){if(!confirm('書きかけの内容を閉じてログアウトしますか？'))return;}\n const previous=session;forgetLogin();session=null;own=[];reset();objectURLs.forEach(u=>URL.revokeObjectURL(u));objectURLs=[];\n for(const id of ['owner','review','admin','account'])$(id).hidden=true;\n $('ownPosts').replaceChildren();$('requests').replaceChildren();$('article').replaceChildren();$('shopName').textContent='';$('accountName').textContent='';$('locationName').textContent='現在：お店の管理';$('code').value='';$('login').hidden=false;\n if(previous)try{await rpc('postLogout',[previous.id,previous.code]);}catch{status('このスマホのログイン情報は消しました。通信を確認し、もう一度ログインしてください。');return;}\n status('ログアウトしました。');$('code').focus();\n};\nasync function restoreLogin(){\n const saved=readLogin();if(!saved)return;\n $('login').hidden=true;status('自分のお店を開いています…');\n try{const r=await rpc('postLogin',[saved.id,saved.token,true]);enterOwnPage(saved.id,saved.token,r,true);}\n catch{forgetLogin();$('login').hidden=false;status('ログインを確認できませんでした。通信を確認して、専用コードをもう一度入力してください。');}\n}\nfunction renderOwn(){$('ownPosts').replaceChildren();if(!own.length)$('ownPosts').append(el('p','まだ記事はありません。'));own.forEach(p=>{const box=el('article'),type=p.kind==='deal'?'お得情報':'お知らせ';box.append(el('p',type+' ｜ '+p.status,'muted'),el('p',p.body.split('\\n')[0]));const row=el('div',null,'row');for(const [text,fn,cls] of [['記事を見る',()=>show(p,false),'secondary'],['直す',()=>edit(p),'secondary'],[type+'の掲載を終了',()=>deletePost(p),'danger']]){const b=el('button',text,cls);b.type='button';b.onclick=fn;row.append(b);}box.append(row);$('ownPosts').append(box);});}\nfunction reset(){editing=null;draft=null;$('postForm').reset();$('chosen').textContent='';$('liveMedia').replaceChildren();$('body').style.height='170px';$('cancel').hidden=true;}\nfunction edit(p){editing=p;$('owner').hidden=false;$('review').hidden=true;$('body').value=p.body;$('kind').value=p.kind;$('end').value=p.end||'';$('files').value='';$('liveMedia').replaceChildren();media($('liveMedia'),p);$('chosen').textContent='写真・動画はそのまま残ります。別のものを選ぶと差し替えます。';$('cancel').hidden=false;$('composer').scrollIntoView();}\n$('cancel').onclick=reset;\n$('files').onchange=async()=>{const selected=[...$('files').files];$('chosen').textContent=selected.length+'件を選びました';$('liveMedia').replaceChildren();for(const file of selected){const url=URL.createObjectURL(file);objectURLs.push(url);if(file.type.startsWith('image/')){const img=el('img');img.src=url;img.alt='選んだ写真';$('liveMedia').append(img);}else if(file.type.startsWith('video/')){const box=el('div'),img=el('img'),v=el('video'),b=el('button','▶ 動画を見る','wide secondary');v.src=url;v.playsInline=true;v.hidden=true;b.type='button';b.onclick=()=>{img.hidden=true;v.hidden=false;v.controls=true;v.play().catch(()=>{});b.hidden=true;};box.append(img,v,b);$('liveMedia').append(box);const poster=await videoPoster(file);if(poster){img.src=poster;img.alt='選んだ動画の表紙';v.poster=poster;}else img.hidden=true;}}};\nfunction dataURL(blob){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(blob);});}\nasync function photo(file){const im=await createImageBitmap(file),canvas=document.createElement('canvas'),r=Math.min(1,1000/Math.max(im.width,im.height));canvas.width=Math.round(im.width*r);canvas.height=Math.round(im.height*r);canvas.getContext('2d').drawImage(im,0,0,canvas.width,canvas.height);im.close();let q=.75,s=canvas.toDataURL('image/jpeg',q);while(s.length>230000&&q>.25){q-=.1;s=canvas.toDataURL('image/jpeg',q);}if(s.length>240000)throw Error('写真が大きすぎます。別の写真を選んでください。');return s;}\nasync function videoPoster(file){return new Promise(resolve=>{const v=document.createElement('video'),url=URL.createObjectURL(file);v.muted=true;v.playsInline=true;let done=false;const finish=value=>{if(done)return;done=true;URL.revokeObjectURL(url);resolve(value);};v.onloadedmetadata=()=>v.currentTime=Math.min(.1,(v.duration||1)/2);v.onseeked=()=>{try{const c=document.createElement('canvas'),r=Math.min(1,480/v.videoWidth);c.width=Math.round(v.videoWidth*r);c.height=Math.round(v.videoHeight*r);c.getContext('2d').drawImage(v,0,0,c.width,c.height);finish(c.toDataURL('image/jpeg',.65));}catch{finish('');}};v.onerror=()=>finish('');v.src=url;setTimeout(()=>finish(''),5000);});}\nfunction ogImage(src,name,body,kind){return new Promise(resolve=>{const draw=image=>{const c=document.createElement('canvas'),x=c.getContext('2d'),W=1200,H=630,left=650;c.width=W;c.height=H;x.fillStyle='#eef5f0';x.fillRect(0,0,W,H);if(image){const r=Math.min(left/image.naturalWidth,H/image.naturalHeight),w=image.naturalWidth*r,h=image.naturalHeight*r;x.fillStyle='#dce9e1';x.fillRect(0,0,left,H);x.drawImage(image,(left-w)/2,(H-h)/2,w,h);}x.fillStyle='#fff';x.fillRect(left,0,W-left,H);x.fillStyle=kind==='deal'?'#a75d00':'#146b57';x.fillRect(left,0,W-left,18);x.fillStyle='#146b57';x.font='700 28px sans-serif';x.fillText(name,left+42,78,W-left-84);x.fillStyle='#173b32';x.font='700 44px sans-serif';const words=Array.from((body||'お店からのお知らせ').replace(/\\s+/g,' ')),lines=[];let line='';for(const ch of words){if(x.measureText(line+ch).width>W-left-84){lines.push(line);line=ch;if(lines.length===4)break;}else line+=ch;}if(line&&lines.length<4)lines.push(line);lines.forEach((t,i)=>x.fillText(t,left+42,155+i*64,W-left-84));x.fillStyle='#5d7667';x.font='600 24px sans-serif';x.fillText(kind==='deal'?'お得情報':'お知らせ',left+42,H-92);x.fillStyle='#146b57';x.font='700 23px sans-serif';x.fillText('志木なるほど お店めぐりDX',left+42,H-48);let q=.86,data=c.toDataURL('image/jpeg',q);while(data.length>630000&&q>.45){q-=.08;data=c.toDataURL('image/jpeg',q);}resolve(data);};if(!src){draw(null);return;}const image=new Image();image.onload=()=>draw(image);image.onerror=()=>draw(null);image.src=src;});}\n$('postForm').onsubmit=async e=>{e.preventDefault();if(busyFlag)return;busy(true);try{const files=[...$('files').files],images=files.filter(f=>f.type.startsWith('image/')),videos=files.filter(f=>f.type.startsWith('video/'));if(images.length>4||videos.length>1||images.length+videos.length!==files.length)throw Error('写真4枚・動画1本まで選べます。');if(videos[0]?.size>25*1024*1024)throw Error('動画は25MB以内の短い動画を選んでください。');const photos=files.length?await Promise.all(images.map(photo)):(editing?.photos||[]);draft={id:editing?.id||'',revision:editing?.request||'',kind:$('kind').value,body:$('body').value.trim(),end:$('end').value,photos,keepVideo:!files.length&&!!editing?.videoFileId};if(videos.length){draft.video=await dataURL(videos[0]);draft.poster=await videoPoster(videos[0]);}draft.ogImage=await ogImage(photos[0]||draft.poster||'', $('shopName').textContent,draft.body,draft.kind);const preview={...draft,videoFileId:draft.keepVideo?editing.videoFileId:''};if(draft.video){const blob=videos[0],url=URL.createObjectURL(blob);objectURLs.push(url);preview.video=url;}show(preview,true);$('status').hidden=true;}catch(e){status(e.message||'写真・動画を読み込めませんでした。');}finally{busy(false);}};\nfunction show(p,review){$('owner').hidden=true;$('review').hidden=false;article($('article'),p);$('reviewTitle').textContent=review?'この内容で投稿しますか？':'自分のお店の投稿';$('reviewState').textContent=review?'まだ投稿されていません。見え方を確認して、最後に投稿してください。':p.status==='公開'?'公開済みです':p.status==='見送り'?'見送り：内容を直して投稿できます。':'投稿受付済み・ふじこの確認待ちです。';$('reviewActions').hidden=!review;$('completeActions').hidden=review;$('viewPublic').hidden=review||p.status!=='公開';$('viewPublic').href=base+'article.html?id='+encodeURIComponent(p.id||'');$('pendingNote').hidden=p.status==='公開';$('review').scrollIntoView();}\n$('rewrite').onclick=()=>{$('review').hidden=true;$('owner').hidden=false;$('composer').scrollIntoView();};\n$('send').onclick=async()=>{if(!draft||busyFlag)return;status('送信しています。このままお待ちください。');try{const r=await rpc('postSend',[session.id,session.code,draft]);own=r.posts;const p=own.find(p=>p.id===r.id);reset();renderOwn();show(p,false);$('reviewTitle').textContent='投稿を受け付けました';$('status').hidden=true;}catch{}};\n$('back').onclick=async()=>{try{own=await rpc('postOwn',[session.id,session.code]);$('review').hidden=true;$('owner').hidden=false;renderOwn();$('ownList').scrollIntoView();$('status').hidden=true;}catch{}};\nasync function deletePost(p){const type=p.kind==='deal'?'お得情報':'お知らせ';if(!confirm('この'+type+'の掲載を今すぐ終了しますか？\\n自分のお店の操作で、記事一覧・タイムライン・お店のページからすぐ非表示になります。'))return;try{status(type+'の掲載を終了しています…');const r=await rpc('postDelete',[session.id,session.code,p.id,p.request]);own=r.posts;renderOwn();status(type+'の掲載を終了しました。');}catch{}}\nfunction renderAdmin(rows){$('requests').replaceChildren();if(!rows.length)$('requests').append(el('p','確認待ちはありません。'));rows.forEach(p=>{const box=el('article');p.name=p.shop;article(box,p);box.prepend(el('p',p.date+(p.ended?'・掲載終了申請':''),'muted'));const label=el('label'),check=el('input');check.type='checkbox';check.style.width='auto';label.append(check,document.createTextNode('掲載内容を確認しました'));box.append(label);const publish=el('button','確認して公開','wide');publish.onclick=async()=>{if(!check.checked){status('掲載内容を確認してチェックしてください。');return;}try{const r=await rpc('postApprove',[session.code,p.request,true]);renderAdmin(r.posts);status('公開しました。DXのタイムラインとお店のページに反映されます。');}catch{}};const reject=el('button','見送る','wide secondary');reject.onclick=async()=>{try{const r=await rpc('postApprove',[session.code,p.request,false]);renderAdmin(r.posts);status('見送りにしました。');}catch{}};box.append(publish,reject);$('requests').append(box);});}\nrestoreLogin();\n</script></body></html>\n\n";
