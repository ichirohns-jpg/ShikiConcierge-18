/**
 * 志木なるほど お店めぐりDX：公開承認済み店舗だけを配信
 * このコードは新規作成した単独の Apps Script プロジェクトに貼り付けます。
 * 個人情報を含む登録申請シートは公開しません。
 */
function publicShopsGet_(e) {
  const callback = (e && e.parameter && e.parameter.callback) || '';
  const sheet = SpreadsheetApp.openById('1u9JGrQkqml6qoNqIk-nuLxdcFXAPQ_COkCX3vA7cSX8').getSheetByName('店舗一覧');
  if (!sheet) return respond_({ok:false,error:'店舗一覧シートがありません'}, callback);
  const values = sheet.getDataRange().getDisplayValues();
  if (!values.length) return respond_({ok:true,shops:[]}, callback);
  const headers = values.shift();
  const col = name => headers.indexOf(name);
  const get = (row, name) => col(name) < 0 ? '' : String(row[col(name)] || '').trim();
  const shops = values.filter(row => {
    const state = get(row, '公開状態');
    const permission = get(row, '掲載許可');
    return state === '公開' && ['確認済み','承認済み','はい','YES'].includes(permission) && get(row, '店名');
  }).map(row => ({
    id: get(row, '店舗ID'),
    name: get(row, '店名'),
    category: get(row, '業種'),
    address: get(row, '住所'),
    description: get(row, '紹介文'),
    recommendation: get(row, 'おすすめ商品・サービス'),
    hours: get(row, '営業時間'),
    closed: get(row, '定休日'),
    phone: get(row, '電話番号'),
    site: get(row, '公式サイトURL'),
    map: get(row, 'GoogleマップURL'),
    instagram: get(row, 'Instagram URL'),
    facebook: get(row, 'Facebook URL'),
    line: get(row, 'LINE公式URL'),
    youtube: get(row, 'YouTube URL'),
    photo: get(row, '写真URL'),
    video: get(row, '動画URL'),
    message: get(row, '店主のひと言'),
    updated: get(row, '更新日')
  }));
  return respond_({ok:true,shops:shops}, callback);
}

function respond_(data, callback) {
  const json = JSON.stringify(data).replace(/</g, '\\u003c');
  // GitHub Pages から読み込むため JSONP を使用。
  // コールバック名は英数字・_・. のみ許可し、コード注入を防止。
  if (callback && /^[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*$/.test(callback) && callback.length < 100) {
    return ContentService.createTextOutput(callback + '(' + json + ');')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService.createTextOutput(json)
    .setMimeType(ContentService.MimeType.JSON);
}
function doGet(e){const p=(e&&e.parameter)||{};if(p.action==='ownerVersion')return respond_(ownerVersion_(),p.callback||'');if(p.mode==='edit')return HtmlService.createHtmlOutput(POST_EDITOR_HTML.replace(/__OMISE_INITIAL_KIND__/g,p.kind==='deal'?'deal':'notice')).setTitle('お店の情報を更新').addMetaTag('viewport','width=device-width,initial-scale=1');if(p.mode==='scenes')return HtmlService.createHtmlOutput(SCENES_HTML).setTitle('お店の紹介を直す').addMetaTag('viewport','width=device-width,initial-scale=1');if(p.mode==='info')return HtmlService.createHtmlOutput(MERCHANT_HTML).setTitle('お店の基本情報を更新').addMetaTag('viewport','width=device-width,initial-scale=1');if(p.mode==='postShare')return postShareHtml_(p.id||'');if(p.action==='posts')return respond_(postFeed_(p),p.callback||'');if(p.action==='thanksCard')return respond_(thanksCardPublic_(),p.callback||'');if(p.action==='merchantPublic'){if(!/^SHOP-[0-9]{4}$/.test(p.shop||''))return respond_({ok:false},p.callback||'');return respond_(omPublic_(p.shop),p.callback||'');}return publicShopsGet_(e);}
const OM_BOOK='1u9JGrQkqml6qoNqIk-nuLxdcFXAPQ_COkCX3vA7cSX8';
function omBook_(){return SpreadsheetApp.openById(OM_BOOK);}
function omSheet_(name,headers){const b=omBook_();let s=b.getSheetByName(name);if(!s){s=b.insertSheet(name);s.appendRow(headers);s.setFrozenRows(1);}return s;}
function setupMerchantEditing(){
 const b=omBook_(), access=omSheet_('店舗管理',['店舗ID','店名','店主用コード（本人だけに渡す）']);
 const rows=b.getSheetByName('店舗一覧').getDataRange().getDisplayValues(),h=rows.shift();
 const props=PropertiesService.getScriptProperties();
 rows.filter(r=>r[h.indexOf('店舗ID')]&&r[h.indexOf('店名')]).forEach(r=>{const id=r[h.indexOf('店舗ID')];if(!props.getProperty('merchant:'+id)){const code=Utilities.getUuid().replace(/-/g,'');props.setProperty('merchant:'+id,code);access.appendRow([id,r[h.indexOf('店名')],code]);}});
 if(!props.getProperty('merchant:ADMIN')){const code=Utilities.getUuid().replace(/-/g,'');props.setProperty('merchant:ADMIN',code);access.appendRow(['ADMIN','ふじこ編集長用（店主には渡さない）',code]);}
 omSheet_('店主申請',['申請ID','受付日時','店舗ID','種類','状態','内容','公開済みJSON','処理日時']);
 omSheet_('店主画像データ',['画像ID','分割番号','データ']);
 access.getRange('A1:C1').setFontWeight('bold');access.setColumnWidth(0+1,140);access.setColumnWidth(2,280);access.setColumnWidth(3,340);
}
function omAuth_(id,code){const expected=PropertiesService.getScriptProperties().getProperty('merchant:'+String(id));if(!expected||!code||(String(code)!==expected&&!omSessionRead_(id,code)))throw new Error('ログインの有効期限が切れたか、専用コードが違います。もう一度コードを入力してください。');}
function omShop_(id){const rows=omBook_().getSheetByName('店舗一覧').getDataRange().getDisplayValues(),h=rows.shift(),r=rows.find(r=>r[h.indexOf('店舗ID')]===id);if(!r)throw new Error('店舗が見つかりません。');return Object.fromEntries(h.map((k,i)=>[k,r[i]||'']));}
function omShopInfo_(id){const shop=omShop_(id);if(!shop['YouTube URL']&&/^https:\/\/(?:www\.)?(?:youtube\.com|youtu\.be)\//i.test(shop['動画URL']||''))shop['YouTube URL']=shop['動画URL'];return shop;}
function merchantLogin(id,code){omAuth_(id,code);if(id==='ADMIN')return {admin:true,requests:omRequests_()};return {admin:false,shop:omShopInfo_(id)};}
function omImageData_(ids){const s=omBook_().getSheetByName("店主画像データ");const chunks=s?s.getDataRange().getDisplayValues().slice(1):[];return (ids||[]).map(id=>chunks.filter(r=>r[0]===id).sort((a,b)=>Number(a[1])-Number(b[1])).map(r=>r[2]).join(""));}
const THANKS_CARD_ACTIVE_='thanks:activeImage';
function thanksCardPublic_(){const id=PropertiesService.getScriptProperties().getProperty(THANKS_CARD_ACTIVE_)||'',image=id?(omImageData_([id])[0]||''):'';return {ok:true,image:/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(image)?image:''};}
function thanksCardSet(code,image,shopId){
 const manager=String(shopId||'ADMIN');if(!['ADMIN','SHOP-0002'].includes(manager))throw Error('このお店ではありがとうカードを変更できません。');omAuth_(manager,code);
 if(!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(String(image||''))||String(image).length>650000)throw Error('カード画像を確認してください。');
 const lock=LockService.getScriptLock();lock.waitLock(20000);try{
  const props=PropertiesService.getScriptProperties(),old=props.getProperty(THANKS_CARD_ACTIVE_)||'',id='THANKS-'+Utilities.getUuid(),sheet=omSheet_('店主画像データ',['画像ID','分割番号','データ']),parts=[];
  for(let i=0;i<image.length;i+=35000)parts.push([id,parts.length,image.slice(i,i+35000)]);
  sheet.getRange(sheet.getLastRow()+1,1,parts.length,3).setValues(parts);props.setProperty(THANKS_CARD_ACTIVE_,id);
  if(old){const rows=sheet.getDataRange().getDisplayValues();for(let i=rows.length-1;i>=1;i--)if(rows[i][0]===old)sheet.deleteRow(i+1);}
  return {ok:true,image:image};
 }finally{lock.releaseLock();}
}
function omRequests_(){const s=omSheet_('店主申請',['申請ID','受付日時','店舗ID','種類','状態','内容','公開済みJSON','処理日時']);return s.getDataRange().getDisplayValues().slice(1).filter(r=>r[4]==='確認待ち').map(r=>({id:r[0],date:r[1],shop:r[2],type:r[3],payload:JSON.parse(r[5]),previews:r[3]==="media"?omImageData_(JSON.parse(r[5]).photos):[]}));}
function omText_(v,n){return String(v||'').trim().slice(0,n);}
function omUrl_(v){v=omText_(v,1500);if(v&&!/^https?:\/\//i.test(v))throw new Error('リンクはhttps://またはhttp://から入力してください。');return v;}
function merchantSubmit(id,code,type,p){
 omAuth_(id,code);if(id==='ADMIN')throw new Error('店舗IDで送信してください。');omShop_(id);if(!['info','media','notice'].includes(type))throw new Error('申請の種類が違います。');
 const data={};
 if(type==='info'){['店名','業種','住所','紹介文','おすすめ商品・サービス','営業時間','定休日','電話番号','店主のひと言'].forEach(k=>{if(Object.prototype.hasOwnProperty.call(p,k))data[k]=omText_(p[k],k==='紹介文'?1500:500);});['公式サイトURL','Instagram URL','Facebook URL','LINE公式URL','YouTube URL'].forEach(k=>{if(Object.prototype.hasOwnProperty.call(p,k))data[k]=omUrl_(p[k]);});if(!data['店名'])throw new Error('店名を入力してください。');}
 if(type==='notice'){data.title=omText_(p.title,80);data.body=omText_(p.body,1500);data.end=omText_(p.end,10);if(!data.title||!data.body)throw new Error('タイトルと本文を入力してください。');if(data.end&&!/^\d{4}-\d{2}-\d{2}$/.test(data.end))throw new Error('終了日を確認してください。');}
 const images=[];
 if(type==='media'){data.video=omUrl_(p.video);if(data.video&&!/^https:\/\/(?:www\.)?(?:youtube\.com|youtu\.be|instagram\.com|facebook\.com)\//i.test(data.video))throw new Error('動画はYouTube・Instagram・Facebookのリンクを入力してください。');if(!Array.isArray(p.photos)||p.photos.length>4)throw new Error('写真は4枚までです。');p.photos.forEach(v=>{if(!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(v)||v.length>240000)throw new Error('写真の形式またはサイズを確認してください。');images.push(v);});if(!images.length&&!data.video)throw new Error('写真または動画のリンクを入れてください。');}
 const lock=LockService.getScriptLock();lock.waitLock(15000);try{
 const key='REQ-'+Utilities.getUuid(),blobSheet=omSheet_('店主画像データ',['画像ID','分割番号','データ']);
 if(type==='info'){const master=omBook_().getSheetByName('店舗一覧'),rows=master.getDataRange().getDisplayValues(),headers=rows[0],row=rows.findIndex(r=>r[headers.indexOf('店舗ID')]===id);if(row<1)throw Error('店舗が見つかりません。');if(Object.prototype.hasOwnProperty.call(data,'YouTube URL'))data['動画URL']=data['YouTube URL'];const missing=Object.keys(data).filter(k=>headers.indexOf(k)<0);if(typeof master.getMaxColumns==='function'&&headers.length+missing.length>master.getMaxColumns())master.insertColumnsAfter(master.getMaxColumns(),headers.length+missing.length-master.getMaxColumns());missing.forEach(k=>{headers.push(k);master.getRange(1,headers.length).setValue(k);});Object.keys(data).forEach(k=>{const col=headers.indexOf(k);if(col>=0)master.getRange(row+1,col+1).setValue(String(data[k]).startsWith('=')?"'"+data[k]:data[k]);});[['公開状態','公開'],['掲載許可','確認済み']].forEach(([key,value])=>{const col=headers.indexOf(key);if(col>=0)master.getRange(row+1,col+1).setValue(value);});const now=Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd HH:mm:ss'),updated=headers.indexOf('更新日');if(updated>=0)master.getRange(row+1,updated+1).setValue(now.slice(0,10));omSheet_('店主申請',['申請ID','受付日時','店舗ID','種類','状態','内容','公開済みJSON','処理日時']).appendRow([key,now,id,type,'公開',JSON.stringify(data),JSON.stringify(data),now]);return {ok:true,id:key,message:'保存しました。基本情報に反映しました。'};}
 if(images.length){data.photos=images.map((v,i)=>{const imageId=key+'-'+i;const chunks=[];for(let j=0;j<v.length;j+=35000)chunks.push([imageId,chunks.length,v.slice(j,j+35000)]);blobSheet.getRange(blobSheet.getLastRow()+1,1,chunks.length,3).setValues(chunks);return imageId;});}
 omSheet_('店主申請',['申請ID','受付日時','店舗ID','種類','状態','内容','公開済みJSON','処理日時']).appendRow([key,Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd HH:mm:ss'),id,type,'確認待ち',JSON.stringify(data),'','']);return {ok:true,id:key,message:'送信しました。ふじこの確認後に公開されます。'};
 }finally{lock.releaseLock();}
}
function merchantDecide(code,requestId,approve,permission){omAuth_('ADMIN',code);const lock=LockService.getScriptLock();lock.waitLock(15000);try{const b=omBook_(),s=b.getSheetByName('店主申請'),rows=s.getDataRange().getDisplayValues(),index=rows.findIndex(r=>r[0]===requestId);if(index<1||rows[index][4]!=='確認待ち')throw new Error('この申請は処理済みです。');const r=rows[index],p=JSON.parse(r[5]);if(approve){if(!permission)throw new Error('掲載許可と内容を確認してください。');if(r[3]==='info'){const master=b.getSheetByName('店舗一覧'),all=master.getDataRange().getDisplayValues(),h=all[0],ri=all.findIndex(row=>row[h.indexOf('店舗ID')]===r[2]);if(ri<1)throw new Error('店舗がありません。');Object.keys(p).forEach(k=>{const ci=h.indexOf(k);if(ci>=0)master.getRange(ri+1,ci+1).setValue(String(p[k]).startsWith("=")?"'"+p[k]:p[k]);});[['公開状態','公開'],['掲載許可','確認済み'],['更新日',Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd')]].forEach(([k,v])=>{const ci=h.indexOf(k);if(ci>=0)master.getRange(ri+1,ci+1).setValue(v);});}s.getRange(index+1,7).setValue(JSON.stringify(p));}s.getRange(index+1,5).setValue(approve?'公開':'見送り');s.getRange(index+1,8).setValue(Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd HH:mm:ss'));return {ok:true,requests:omRequests_()};}finally{lock.releaseLock();}}
function omPublicShop_(id,hasPublishedInfo){const source=omShopInfo_(id);if(!hasPublishedInfo&&(source['公開状態']!=='公開'||!['確認済み','承認済み','はい','YES'].includes(source['掲載許可'])))return null;const keys=['店名','業種','住所','紹介文','おすすめ商品・サービス','営業時間','定休日','電話番号','店主のひと言','公式サイトURL','Instagram URL','Facebook URL','LINE公式URL','YouTube URL','写真URL','動画URL','GoogleマップURL'];return Object.fromEntries(keys.map(key=>[key,String(source[key]||'')]));}
function omPublic_(id){const s=omBook_().getSheetByName('店主申請');const result={ok:true,shop:omPublicShop_(id),notice:null,photos:[],video:''};if(!s){result.scenes=omScenesRead_(id).scenes;return result;}const rows=s.getDataRange().getDisplayValues().slice(1).filter(r=>r[2]===id&&r[4]==='公開');rows.forEach(r=>{const p=JSON.parse(r[6]||'{}');if(r[3]==='notice'){result.notice=p;}if(r[3]==='media'){result.video=p.video||'';result.photos=p.photos||[];}});if(rows.some(r=>r[3]==='info'))result.shop=omPublicShop_(id,true);if(result.notice&&result.notice.end&&result.notice.end<Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd'))result.notice=null;
 if(result.photos.length){const chunks=omBook_().getSheetByName('店主画像データ').getDataRange().getDisplayValues().slice(1);result.photos=result.photos.map(id=>chunks.filter(r=>r[0]===id).sort((a,b)=>Number(a[1])-Number(b[1])).map(r=>r[2]).join(''));}result.scenes=omScenesRead_(id).scenes;return result;}

const MERCHANT_HTML="<!doctype html><html lang=\"ja\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>お店の情報を更新｜志木なるほど お店めぐりDX</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f8f4;color:#193f33;font:16px/1.8 -apple-system,BlinkMacSystemFont,sans-serif}main{max-width:620px;padding:18px;margin:auto}section{background:white;border:1px solid #d4e5db;padding:20px;border-radius:16px;margin:16px 0}h1{font-size:25px}h2{font-size:22px}label{display:block;font-weight:700;margin-top:12px}input,textarea,select,button{font:inherit;width:100%;padding:12px;border:1px solid #a8c8b7;border-radius:10px}textarea{min-height:130px}button{background:#146b57;color:white;font-weight:700;margin-top:14px;cursor:pointer}button:disabled{opacity:.6}.secondary{background:#e4f1e9;color:#193f33}.muted{font-size:14px;color:#536d5f}#status{background:#fff5dd;padding:12px;border-radius:10px}img{max-width:100%;border-radius:12px}.preview{display:grid;grid-template-columns:1fr 1fr;gap:8px}[hidden]{display:none!important}a{color:#146b57}.request{border-top:1px solid #d4e5db;padding:14px 0;white-space:pre-wrap}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid orange;outline-offset:3px}</style></head><body><main><h1>お店の情報を更新</h1><p>基本情報は保存するとすぐ反映されます。</p><p><a class=\"btn wide secondary\" href=\"https://script.google.com/macros/s/AKfycbzMec1R3le4e-cOUyBUl6Eq2dU3OI-5HHtkEyJQT7SWx4IjUHGtW8Z3zatJxoA2GUhn2A/exec?mode=scenes\" target=\"_top\">お店の紹介を直す（タイトル・画像・説明文 × 4）</a></p><section id=\"login\"><form id=\"loginForm\"><label for=\"code\">専用コード</label><input id=\"code\" type=\"password\" autocomplete=\"current-password\" required><p class=\"muted\">お店にお渡ししたコードを入力してください。コードはほかの人に教えないでください。</p><p class=\"muted\">このスマホでは30日間ログインを保持します。</p><button>更新画面を開く</button></form></section><section id=\"editor\" hidden><h2 id=\"shopName\"></h2><select id=\"kind\" hidden><option value=\"info\">基本情報</option></select><form id=\"editForm\"><div id=\"infoFields\"></div><div id=\"mediaFields\" hidden><label for=\"photos\">スマホから写真を選ぶ（4枚まで）</label><input id=\"photos\" type=\"file\" accept=\"image/*\" multiple><div class=\"preview\" id=\"previews\"></div><label for=\"video\">動画のリンク（任意）</label><input id=\"video\" type=\"url\" placeholder=\"YouTubeなどの動画URL\"><p class=\"muted\">写真はスマホから選べます。動画はYouTube・Instagram・Facebookのリンクを貼ってください。</p></div><div id=\"noticeFields\" hidden><label for=\"noticeTitle\">お知らせのタイトル</label><input id=\"noticeTitle\" maxlength=\"80\"><label for=\"noticeBody\">お知らせの本文</label><textarea id=\"noticeBody\" maxlength=\"1500\"></textarea><label for=\"noticeEnd\">いつまで載せる？（任意）</label><input id=\"noticeEnd\" type=\"date\"><p class=\"muted\">特典の内容・条件・期間は、お店で実施するものだけを書いてください。</p></div><button id=\"submit\">基本情報を保存する</button></form></section><section id=\"admin\" hidden><h2>以前の申請</h2><div id=\"requests\"></div></section><p id=\"status\" role=\"status\" aria-live=\"polite\" hidden></p><button id=\"retryLogin\" type=\"button\" class=\"secondary\" hidden>もう一度接続する</button><a href=\"https://ichirohns-jpg.github.io/ShikiConcierge-18/omise-demo/\" target=\"_top\">⌂ DXトップへ戻る</a></main><script>\nconst sessionMemory=(()=>{\n const key='shiki-merchant-session-v1';\n const valid=a=>a&&/^(SHOP-[0-9]{4}|ADMIN)$/.test(a.id)&&/^DXS1\\.[a-f0-9]{64}$/.test(a.token)&&Number.isFinite(a.expiresAt)&&a.expiresAt>Date.now();\n return {\n  read(){try{const a=JSON.parse(localStorage.getItem(key)||'null');if(valid(a))return a;if(a)localStorage.removeItem(key);}catch{}return null;},\n  save(a){if(!valid(a))return false;try{localStorage.setItem(key,JSON.stringify({id:a.id,token:a.token,expiresAt:a.expiresAt}));return true;}catch{return false;}},\n  forget(){try{localStorage.removeItem(key);}catch{}},\n  authError(e){return /有効期限|専用コードが違|セッション.*(?:無効|失効)|invalid.*(?:session|token)/i.test(e?.message||String(e));}\n };\n})();\nconst $=id=>document.getElementById(id);let session=null,photos=[];const fields=['店名','業種','住所','紹介文','おすすめ商品・サービス','営業時間','定休日','電話番号','公式サイトURL','Instagram URL','Facebook URL','LINE公式URL','YouTube URL','店主のひと言'];\nfunction status(t){$('status').hidden=false;$('status').textContent=t;}function busy(on){document.querySelectorAll('button').forEach(b=>b.disabled=on);}function fail(e){busy(false);status(e.message||String(e));}\nfunction rpc(name,args,done,failed=fail){busy(true);google.script.run.withSuccessHandler(r=>{busy(false);done(r);}).withFailureHandler(e=>{busy(false);failed(e);})[name](...args);}\nfunction enterInfo(id,credential,r){\n const auth=r.auth;session={id,code:auth?.token||credential};let saved=sessionMemory.save(auth)||sessionMemory.read()?.token===session.code;\n $('login').hidden=true;$('code').value='';$('retryLogin').hidden=true;\n if(r.admin){$('admin').hidden=false;renderRequests(r.requests);}\n else{$('editor').hidden=false;$('shopName').textContent=r.shop['店名'];$('infoFields').replaceChildren();fields.forEach((k,i)=>{const label=document.createElement('label');label.htmlFor='field'+i;label.textContent=k;const input=document.createElement(k==='紹介文'||k==='おすすめ商品・サービス'?'textarea':'input');input.id='field'+i;input.dataset.field=k;input.value=r.shop[k]||'';input.maxLength=k==='紹介文'?1500:500;$('infoFields').append(label,input);});}\n status(saved?'基本情報を直して、保存してください。':'このブラウザではログインを保存できませんでした。この画面では引き続き使えます。');\n}\n$('loginForm').onsubmit=e=>{e.preventDefault();const code=$('code').value.trim();rpc('postLoginByCode',[code,true],r=>enterInfo(r.loginId,code,r));};\nfunction restoreInfoLogin(){\n const saved=sessionMemory.read();if(!saved)return;\n $('login').hidden=true;$('retryLogin').hidden=true;status('自分のお店を開いています…');\n rpc('postLogin',[saved.id,saved.token,true],r=>enterInfo(saved.id,saved.token,r),e=>{\n  if(sessionMemory.authError(e)){sessionMemory.forget();$('login').hidden=false;status('ログインの有効期限が切れました。専用コードを入力してください。');}\n  else{$('retryLogin').hidden=false;status('接続できませんでした。保存したログイン情報は残っています。');}\n });\n}\n$('retryLogin').onclick=restoreInfoLogin;restoreInfoLogin();\n$('kind').onchange=()=>{['info','media','notice'].forEach(k=>$(k+'Fields').hidden=$('kind').value!==k);$('submit').textContent=$('kind').value==='info'?'基本情報を保存する':'確認をお願いして送る';};\n$('photos').onchange=async()=>{photos=[];$('previews').replaceChildren();const files=[...$('photos').files];if(files.length>4){$('photos').value='';status('写真は4枚まで選んでください。');return;}busy(true);try{for(const f of files){const im=await createImageBitmap(f);const canvas=document.createElement('canvas');const ratio=Math.min(1,1000/Math.max(im.width,im.height));canvas.width=Math.round(im.width*ratio);canvas.height=Math.round(im.height*ratio);canvas.getContext('2d').drawImage(im,0,0,canvas.width,canvas.height);let q=.76,data=canvas.toDataURL('image/jpeg',q);while(data.length>230000&&q>.25){q-=.1;data=canvas.toDataURL('image/jpeg',q);}im.close();if(data.length>240000)throw Error('写真が大きすぎます。別の写真を選んでください。');photos.push(data);const img=document.createElement('img');img.src=data;img.alt='送信する写真';$('previews').append(img);}status(photos.length+'枚を選びました。まだ送信されていません。');}catch(e){photos=[];$('photos').value='';$('previews').replaceChildren();status('写真を読み込めませんでした。JPEGなどの別の写真でお試しください。');}busy(false);};\n$('editForm').onsubmit=e=>{e.preventDefault();const type=$('kind').value;let p={};if(type==='info')document.querySelectorAll('[data-field]').forEach(i=>p[i.dataset.field]=i.value);if(type==='notice')p={title:$('noticeTitle').value,body:$('noticeBody').value,end:$('noticeEnd').value};if(type==='media')p={photos,video:$('video').value};rpc('merchantSubmit',[session.id,session.code,type,p],r=>{status(type==='info'?r.message:r.message+' 受付番号：'+r.id);$('submit').textContent=type==='info'?'基本情報を保存する':'続けて別の変更を送る';});};\nfunction renderRequests(rows){$('requests').replaceChildren();if(!rows.length){$('requests').textContent='確認待ちはありません。';return;}rows.forEach(r=>{const box=document.createElement('div');box.className='request';const text=document.createElement('p');text.textContent=r.shop+' / '+({info:'お店の情報',media:'写真・動画',notice:'お知らせ'}[r.type])+'\\n'+r.date+'\\n'+JSON.stringify(r.payload,null,2);box.append(text);(r.previews||[]).forEach(src=>{const img=document.createElement(\"img\");img.src=src;img.alt=\"申請された写真\";box.append(img);});const label=document.createElement('label'),check=document.createElement('input');check.type='checkbox';check.style.width='auto';label.append(check,document.createTextNode('店舗の掲載許可と内容を確認しました'));box.append(label);for(const approve of [true,false]){const btn=document.createElement('button');btn.type='button';btn.textContent=approve?'確認して公開する':'見送る';if(!approve)btn.className='secondary';btn.onclick=()=>rpc('merchantDecide',[session.code,r.id,approve,check.checked],res=>{renderRequests(res.requests);status(approve?'公開しました。':'見送りにしました。');});box.append(btn);}$('requests').append(box);});}\n</script></body></html>\n";

/* Article revisions: an authenticated shop publishes immediately. */
function postSheet_(){return omSheet_('投稿記事',['受付ID','記事ID','店舗ID','日時','状態','内容JSON','処理日時']);}
function postRows_(){return postSheet_().getDataRange().getDisplayValues().slice(1).filter(r=>r[0]);}
function postNow_(){return Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd HH:mm:ss');}
function postShareFile_(id){if(!id)return;try{const file=DriveApp.getFileById(id);file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);try{if(file.getSecurityUpdateEligible&&file.getSecurityUpdateEligible())file.setSecurityUpdateEnabled(false);}catch(resourceErr){console.log('投稿画像のリンク保護解除を省略: '+resourceErr);}}catch(err){console.log('投稿ファイルの公開設定に失敗: '+err);}}
function postPublishPending_(){
 const lock=LockService.getScriptLock();lock.waitLock(20000);try{
  const s=postSheet_(),rows=s.getDataRange().getDisplayValues(),now=postNow_();
  rows.slice(1).forEach((r,index)=>{if(r[4]!=='確認待ち')return;try{const p=JSON.parse(r[5]);postShareFile_(p.videoFileId);postShareFile_(p.ogImageFileId);}catch(err){console.log('旧投稿の公開移行に失敗: '+err);}s.getRange(index+2,5).setValue('公開');s.getRange(index+2,7).setValue(now);});
 }finally{lock.releaseLock();}
}
function postPayload_(r,images){const p=JSON.parse(r[5]);return {request:r[0],id:r[1],shop:r[2],date:r[3],status:r[4]==='確認待ち'?'公開':r[4],...p,photos:images?omImageData_(p.photos||[]):p.photos||[]};}
function postOwn(id,code){omAuth_(id,code);const rows=postRows_();if(id==='ADMIN')return [];const latest={};rows.filter(r=>r[2]===id).forEach(r=>latest[r[1]]=r);return Object.values(latest).reverse().filter(r=>!JSON.parse(r[5]).ended).map(r=>postPayload_(r,true));}
function postLogin(id,code,remember){const login=merchantLogin(id,code);postPublishPending_();const result={...login,posts:postOwn(id,code),shops:omBook_().getSheetByName('店舗一覧').getDataRange().getDisplayValues().slice(1).filter(r=>r[0]&&r[2]).map(r=>({id:r[0],name:r[2]}))};if(id==='ADMIN'||id==='SHOP-0002')result.thanksCard=thanksCardPublic_().image||'';if(remember===true){const existing=omSessionRead_(id,code);result.auth=existing?{id:String(id),token:code,expiresAt:existing.expiresAt}:omSessionIssue_(id);}return result;}
function postValidateEnd_(kind,end){
 const today=postNow_().slice(0,10);
 if(kind==='deal'&&!end)throw Error('いつまでのお得情報か、終了日を入れてください。');
 if(end){const date=new Date(end+'T00:00:00+09:00');if(!/^\d{4}-\d{2}-\d{2}$/.test(end)||!Number.isFinite(date.getTime())||Utilities.formatDate(date,'Asia/Tokyo','yyyy-MM-dd')!==end)throw Error('終了日を確認してください。');if(end<today)throw Error('終了日は今日以降を選んでください。');}
}
function postSend(id,code,input){
 omAuth_(id,code);if(id==='ADMIN')throw Error('お店を選んで投稿してください。');omShop_(id);
 const body=omText_(input.body,1500),kind=input.kind,end=omText_(input.end,10),ended=input.ended===true;
 if(!['notice','deal'].includes(kind)||!body)throw Error('投稿の種類とひと言を確認してください。');if(!ended)postValidateEnd_(kind,end);
 const clientRequest=String(input.clientRequestId||'');if(clientRequest&&!/^[a-f0-9]{32}$/.test(clientRequest))throw Error('投稿内容を確認し直してください。');
 const photos=input.photos||[];if(!Array.isArray(photos)||photos.length>4||photos.some(v=>!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(v)||v.length>240000))throw Error('写真は4枚まで選んでください。');
 const video=input.video||'';if(video&&(!/^data:video\/(mp4|webm|quicktime);base64,[A-Za-z0-9+/=]+$/i.test(video)||video.length>35000000))throw Error('動画は25MB以内のMP4・MOV・WebMにしてください。');
 const poster=input.poster||'';if(poster&&(!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(poster)||poster.length>240000))throw Error('動画の表紙を確認してください。');
 const ogImage=input.ogImage||'';if(ogImage&&(!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(ogImage)||ogImage.length>650000))throw Error('SNS表示用画像を作成できませんでした。写真を変えてお試しください。');
 const lock=LockService.getScriptLock();lock.waitLock(20000);try{
 const rows=postRows_();
 if(clientRequest){const duplicate=rows.find(r=>r[0]==='REV-'+id+'-'+clientRequest&&r[2]===id);if(duplicate){const saved=JSON.parse(duplicate[5]);if((input.id&&input.id!==duplicate[1])||saved.body!==body||saved.kind!==kind||saved.end!==end)throw Error('投稿内容を確認し直してください。');return {ok:true,id:duplicate[1],request:duplicate[0],status:'公開',posts:postOwn(id,code)};}}
 const previous=input.id?rows.filter(r=>r[1]===input.id).pop():null;
 if(input.id&&(!previous||previous[2]!==id))throw Error('この記事は修正できません。');if(previous&&previous[0]!==input.revision)throw Error('記事が更新されています。一覧を開き直してください。');
 const pid=previous?previous[1]:'POST-'+Utilities.getUuid(),rid='REV-'+(clientRequest?id+'-'+clientRequest:Utilities.getUuid()),p={kind,body,end,ended,photos:[]};
 const chunks=omSheet_('店主画像データ',['画像ID','分割番号','データ']);photos.forEach((v,i)=>{const key=rid+'-'+i,parts=[];for(let j=0;j<v.length;j+=35000)parts.push([key,parts.length,v.slice(j,j+35000)]);chunks.getRange(chunks.getLastRow()+1,1,parts.length,3).setValues(parts);p.photos.push(key);});
 const old=previous?JSON.parse(previous[5]):{};
 if(input.keepVideo&&old.videoFileId){p.videoFileId=old.videoFileId;p.poster=old.poster||'';}
 if(!ogImage&&old.ogImageFileId)p.ogImageFileId=old.ogImageFileId;
 if(ogImage){const match=ogImage.match(/^data:([^;]+);base64,(.+)$/i),file=postSocialFolder_().createFile(Utilities.newBlob(Utilities.base64Decode(match[2]),match[1],pid+'-'+rid+'.jpg'));p.ogImageFileId=file.getId();}
 if(video){const match=video.match(/^data:([^;]+);base64,(.+)$/i),file=postVideoFolder_().createFile(Utilities.newBlob(Utilities.base64Decode(match[2]),match[1],rid+(match[1].toLowerCase()==='video/quicktime'?'.mov':'.mp4')));p.videoFileId=file.getId();p.poster=poster;}
 postShareFile_(p.videoFileId);postShareFile_(p.ogImageFileId);const now=postNow_();postSheet_().appendRow([rid,pid,id,now,'公開',JSON.stringify(p),now]);return {ok:true,id:pid,request:rid,status:'公開',posts:postOwn(id,code)};
 }finally{lock.releaseLock();}
}
function postDelete(id,code,pid,revision){
 omAuth_(id,code);if(id==='ADMIN')throw Error('お店の画面から掲載を終了してください。');omShop_(id);
 if(!/^POST-[a-f0-9-]+$/i.test(String(pid||'')))throw Error('記事を確認できません。');
 const lock=LockService.getScriptLock();lock.waitLock(20000);try{
  const s=postSheet_(),all=s.getDataRange().getDisplayValues(),rows=all.slice(1).filter(r=>r[0]),previous=rows.filter(r=>r[1]===pid).pop();
  if(!previous||previous[2]!==id)throw Error('この記事は操作できません。');
  if(previous[0]!==revision)throw Error('記事が更新されています。一覧を開き直してください。');
  const old=JSON.parse(previous[5]);if(old.ended)return {ok:true,posts:postOwn(id,code)};
  const now=postNow_(),rid='REV-'+Utilities.getUuid(),p={...old,ended:true};
  const previousRow=all.findIndex(r=>r[0]===previous[0]);
  if(previous[4]==='確認待ち'&&previousRow>0){s.getRange(previousRow+1,5).setValue('見送り');s.getRange(previousRow+1,7).setValue(now);}
  s.appendRow([rid,pid,id,now,'公開',JSON.stringify(p),now]);
  return {ok:true,posts:postOwn(id,code)};
 }finally{lock.releaseLock();}
}
function postVideoFolder_(){const props=PropertiesService.getScriptProperties(),id=props.getProperty('postVideoFolder');if(id)return DriveApp.getFolderById(id);const folder=DriveApp.createFolder('お店めぐりDX 投稿動画');props.setProperty('postVideoFolder',folder.getId());return folder;}
function postSocialFolder_(){const props=PropertiesService.getScriptProperties(),id=props.getProperty('postSocialFolder');if(id)return DriveApp.getFolderById(id);const folder=DriveApp.createFolder('お店めぐりDX 記事OGP画像');props.setProperty('postSocialFolder',folder.getId());return folder;}
function postEnsureOgImage_(row){
 const p=JSON.parse(row[5]);if(p.ogImageFileId){postShareFile_(p.ogImageFileId);return p.ogImageFileId;}
 const first=(p.photos||[])[0];if(!first)return '';
 try{
  const data=(omImageData_([first])||[])[0]||'',match=data.match(/^data:([^;]+);base64,(.+)$/i);if(!match)return '';
  const file=postSocialFolder_().createFile(Utilities.newBlob(Utilities.base64Decode(match[2]),match[1],row[1]+'-ogp.jpg'));
  postShareFile_(file.getId());p.ogImageFileId=file.getId();
  const s=postSheet_(),rows=s.getDataRange().getDisplayValues(),i=rows.findIndex(r=>r[0]===row[0]);if(i>0)s.getRange(i+1,6).setValue(JSON.stringify(p));
  return file.getId();
 }catch(err){console.log('既存記事のOGP画像作成失敗: '+err);return '';}
}
function postApprove(code,rid,approve){omAuth_('ADMIN',code);const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=postSheet_(),rows=s.getDataRange().getDisplayValues(),i=rows.findIndex(r=>r[0]===rid);if(i<1||rows[i][4]!=='確認待ち')throw Error('処理済みです。');const r=rows[i],p=JSON.parse(r[5]);if(approve){const newer=rows.slice(i+1).some(x=>x[1]===r[1]);if(newer)throw Error('新しい申請があります。新しい内容を確認してください。');['videoFileId','ogImageFileId'].forEach(k=>{if(p[k])DriveApp.getFileById(p[k]).setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);});}s.getRange(i+1,5).setValue(approve?'公開':'見送り');s.getRange(i+1,7).setValue(postNow_());return {ok:true,posts:postOwn('ADMIN',code)};}finally{lock.releaseLock();}}
function postFeed_(params){const latest={};postRows_().filter(r=>r[4]==='公開'||r[4]==='確認待ち').forEach(r=>latest[r[1]]=r);const today=postNow_().slice(0,10);let rows=Object.values(latest).filter(r=>{const p=JSON.parse(r[5]);return !p.ended&&(!p.end||p.end>=today)&&(!params.shop||r[2]===params.shop)&&(!params.kind||p.kind===params.kind)&&(!params.id||r[1]===params.id);}).sort((a,b)=>b[3].localeCompare(a[3])||b[0].localeCompare(a[0]));const offset=Math.max(0,Math.min(10000,parseInt(params.offset||'0',10)||0));const total=rows.length;rows=rows.slice(offset,offset+10);return {ok:true,total,offset,posts:rows.map(r=>{const raw=JSON.parse(r[5]),p=postPayload_(r,true);delete p.request;const shop=omShop_(r[2]);p.name=shop['店名'];p.address=shop['住所'];delete p.videoFileId;delete p.ogImageFileId;if(raw.videoFileId)p.video='https://drive.google.com/file/d/'+encodeURIComponent(raw.videoFileId)+'/preview';p.shareURL=ScriptApp.getService().getUrl()+'?mode=postShare&v=2&id='+encodeURIComponent(r[1]);return p;})};}
function postEsc_(value){return String(value||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
function postShareHtml_(id){
 if(!/^POST-[a-f0-9-]+$/i.test(String(id||'')))return HtmlService.createHtmlOutput('記事が指定されていません。');
 const feed=postFeed_({id:String(id),offset:'0'}),p=feed.posts&&feed.posts[0];if(!p)return HtmlService.createHtmlOutput('この記事は公開されていないか、掲載が終了しています。');
